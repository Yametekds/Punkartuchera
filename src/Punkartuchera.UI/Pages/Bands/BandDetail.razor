@page "/bandas/{Id:guid}"
@inject BandService Bands
@inject IRulesCatalog Rules
@inject Rulebook Book
@inject GearLookup Lookup
@inject NavigationManager Navigation

<PageTitle>@(_band?.Name ?? "Banda") · Punkartuchera</PageTitle>

@if (_loading)
{
    <p class="muted">Cargando banda…</p>
}
else if (_band is null)
{
    <section class="punk-empty">
        <h1>Esta banda ya no existe</h1>
        <p>O se la comieron los mutardos o la borraste tú.</p>
        <a class="btn btn--primary" href="">Volver a las bandas</a>
    </section>
}
else
{
    <div class="context-bar">
        <div class="context-bar__row">
            <a class="btn btn--icon" href="" aria-label="Volver a las bandas"><Icon Path="@Icons.Back" /></a>
            <label class="visually-hidden" for="band-switch">Cambiar de banda</label>
            <select id="band-switch" class="field__input context-bar__select" value="@_band.Id" @onchange="SwitchBand">
                @foreach (var other in _allBands)
                {
                    <option value="@other.Id">@other.Name@(other.IsReadOnly ? " (rival)" : "")</option>
                }
            </select>
            <ActionsMenu CloseOnClick="true">
                @if (!_band.IsReadOnly)
                {
                    <button type="button" class="menu-pop__item" @onclick="StartEditing"><Icon Path="@Icons.Edit" /> Editar datos</button>
                    <button type="button" class="menu-pop__item" @onclick="() => _sharing = true"><Icon Path="@Icons.Share" /> Pasar al rival</button>
                }
                <button type="button" class="menu-pop__item" @onclick="Duplicate"><Icon Path="@Icons.Copy" /> Clonar banda</button>
                <button type="button" class="menu-pop__item menu-pop__item--danger" @onclick="() => _tab = TabDetails"><Icon Path="@Icons.Trash" /> Borrar…</button>
            </ActionsMenu>
        </div>
    </div>

    <section class="paper band-hero tape">
        <div class="band-hero__top">
            <span class="stamp">@FactionName</span>
            @if (SubfactionName is not null)
            {
                <span class="stamp stamp--ink">@SubfactionName</span>
            }
            @if (_band.IsReadOnly)
            {
                <span class="stamp stamp--ink"><Icon Path="@Icons.Lock" /> Rival</span>
            }
        </div>
        <h1 class="band-hero__name distress">@_band.Name</h1>
        <div class="band-hero__counters">
            <span class="counter"><span class="counter__value">@_band.Members.Count</span><span class="counter__label">@(_band.Members.Count == 1 ? "miembro" : "miembros")</span></span>
            @if (_band.IsReadOnly)
            {
                <span class="counter" title="Las balas del rival son secreto"><span class="counter__value">?</span><span class="counter__label">balas</span></span>
            }
            else
            {
                <span class="counter"><span class="counter__value">@_band.Members.Sum(m => m.Ammo)</span><span class="counter__label">balas</span></span>
            }
            @if (_band.Members.Any(m => m.Cost is not null))
            {
                <span class="counter"><span class="counter__value">@_band.Members.Sum(m => m.Cost ?? 0)</span><span class="counter__label">coste</span></span>
            }
        </div>
    </section>

    @if (_band.IsReadOnly)
    {
        <p class="notice">Banda del rival: solo para cotillear. Ves sus fichas, equipo y habilidades, pero las balas se las guarda.</p>
    }

    @if (_error is not null)
    {
        <p class="notice notice--danger">@_error</p>
    }

    <PageTabs Tabs="TabNames" @bind-Active="_tab" />

    <div class="tab-panel">
        @switch (_tab)
        {
            case TabMembers:
                @if (_band.Members.Count == 0)
                {
                    <section class="punk-empty">
                        <h2>Banda fantasma</h2>
                        <p>Aquí no hay ni un alma. Recluta a alguien antes de que te roben las balas.</p>
                    </section>
                }
                <div class="datacard-list">
                    @foreach (var member in _band.Members)
                    {
                        <MemberCard Member="member" FactionId="@_band.FactionId" HideAmmo="_band.IsReadOnly" Href="@(_band.IsReadOnly ? null : $"bandas/{_band.Id}/miembro/{member.Id}")" />
                    }
                </div>
                break;

            case TabGear:
                @if (GearRows.Count == 0)
                {
                    <p class="muted">Nadie lleva nada encima. Ni un mal tubo.</p>
                }
                else
                {
                    <div class="paper">
                        <table class="data-table">
                            <thead><tr><th scope="col">Equipo</th><th scope="col">Lo lleva</th></tr></thead>
                            <tbody>
                                @foreach (var row in GearRows)
                                {
                                    <tr>
                                        <td>
                                            <strong>@row.Gear</strong>
                                            @if (Lookup.Find(row.Gear, _band.FactionId) is { } info)
                                            {
                                                <span class="gear-item__data" style="display:block">
                                                    @info.Summary
                                                    <button type="button" class="gear-item__link" aria-label="Qué dice el reglamento de @row.Gear" @onclick="() => { _openRule = info; _openRuleTitle = row.Gear; }">regla</button>
                                                </span>
                                            }
                                        </td>
                                        <td>@row.Who</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                break;

            default:
                @if (_editing)
                {
                    <form class="paper stack" @onsubmit="SaveDetails">
                        <label class="field">
                            <span class="field__label">Nombre</span>
                            <input class="field__input" @bind="_draftName" maxlength="@BandService.MaxNameLength" required />
                        </label>
                        <label class="field">
                            <span class="field__label">Facción</span>
                            <select class="field__input" value="@_draftFaction" @onchange="e => { _draftFaction = e.Value?.ToString() ?? string.Empty; _draftSubfaction = string.Empty; }">
                                @foreach (var faction in Rules.Factions)
                                {
                                    <option value="@faction.Id">@faction.Name</option>
                                }
                            </select>
                        </label>
                        @if (Book.FindFaction(_draftFaction) is { Subfactions.Count: > 0 } draftFaction)
                        {
                            <label class="field">
                                <span class="field__label">Subfacción</span>
                                <select class="field__input" @bind="_draftSubfaction">
                                    <option value="">Ninguna (facción base)</option>
                                    @foreach (var subfaction in draftFaction.Subfactions)
                                    {
                                        <option value="@subfaction.Id">@subfaction.Name</option>
                                    }
                                </select>
                            </label>
                        }
                        <label class="field">
                            <span class="field__label">Notas</span>
                            <textarea class="field__input" rows="4" @bind="_draftNotes"></textarea>
                        </label>
                        <div class="actions">
                            <button type="submit" class="btn btn--primary">Guardar</button>
                            <button type="button" class="btn btn--ghost" @onclick="() => _editing = false">Cancelar</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="rule-grid">
                        <div class="rule-box">
                            <h3 class="rule-box__title">Facción</h3>
                            <p>@FactionName@(SubfactionName is null ? "" : $" · {SubfactionName}")</p>
                        </div>
                        <div class="rule-box">
                            <h3 class="rule-box__title">Notas</h3>
                            <p class="band-notes">@(string.IsNullOrWhiteSpace(_band.Notes) ? "Sin notas. Ni un garabato." : _band.Notes)</p>
                        </div>
                        <div class="rule-box">
                            @if (_band.IsReadOnly)
                            {
                                <h3 class="rule-box__title">Recibida</h3>
                                <p>@_band.UpdatedAt.ToLocalTime().ToString("d MMM yyyy"). Si el rival te la vuelve a pasar, se sustituye esta copia.</p>
                            }
                            else
                            {
                                <h3 class="rule-box__title">Fichada</h3>
                                <p>@_band.CreatedAt.ToLocalTime().ToString("d MMM yyyy") · última paliza @_band.UpdatedAt.ToLocalTime().ToString("d MMM yyyy")</p>
                            }
                        </div>
                    </div>
                    <div class="actions">
                        @if (!_band.IsReadOnly)
                        {
                            <button type="button" class="btn btn--ghost" @onclick="StartEditing"><Icon Path="@Icons.Edit" /> Editar datos</button>
                        }
                        <ConfirmButton Text="Mandar al desguace" ConfirmText="Sí, borrarla" OnConfirm="Delete" />
                    </div>
                }
                break;
        }
    </div>

    @if (!_band.IsReadOnly && _tab == TabMembers)
    {
        <a class="btn btn--blood fab" href="@($"bandas/{_band.Id}/miembro/nuevo")"><Icon Path="@Icons.Plus" /> Reclutar</a>
    }

    @if (_sharing)
    {
        <RivalShareSheet BandId="_band.Id" BandName="@_band.Name" OnClose="() => _sharing = false" />
    }
}

@if (_openRule is not null)
{
    <RuleSheet Info="_openRule" Title="@_openRuleTitle" OnClose="() => _openRule = null" />
}

@code {
    private GearInfo? _openRule;
    private string? _openRuleTitle;

    private const string TabMembers = "Miembros";
    private const string TabGear = "Equipo";
    private const string TabDetails = "Datos";
    private static readonly IReadOnlyList<string> TabNames = [TabMembers, TabGear, TabDetails];

    [Parameter] public Guid Id { get; set; }

    private Band? _band;
    private IReadOnlyList<Band> _allBands = [];
    private string _tab = TabMembers;
    private bool _loading = true;
    private bool _editing;
    private string? _error;
    private bool _sharing;
    private string _draftName = string.Empty;
    private string _draftFaction = string.Empty;
    private string? _draftNotes;
    private string _draftSubfaction = string.Empty;

    private string FactionName => Rules.FindFaction(_band?.FactionId)?.Name ?? "Sin facción";

    private string? SubfactionName => Book.FindSubfaction(_band?.SubfactionId)?.Name;

    private List<(string Gear, string Who)> GearRows =>
        _band?.Members
            .SelectMany(m => m.Gear.Select(g => (g.Name, m.Name)))
            .GroupBy(r => r.Item1, StringComparer.OrdinalIgnoreCase)
            .Select(g => (g.Key, string.Join(", ", g.Select(r => r.Item2))))
            .OrderBy(r => r.Item1)
            .ToList() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        _loading = _band?.Id != Id;
        _editing = false;
        _error = null;
        _sharing = false;
        _band = await Bands.GetAsync(Id);
        _allBands = await Bands.GetAllAsync();
        _loading = false;
    }

    private void SwitchBand(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id) && id != Id)
        {
            Navigation.NavigateTo($"bandas/{id}");
        }
    }

    private void StartEditing()
    {
        if (_band is null)
        {
            return;
        }

        _draftName = _band.Name;
        _draftFaction = _band.FactionId;
        _draftSubfaction = _band.SubfactionId ?? string.Empty;
        _draftNotes = _band.Notes;
        _error = null;
        _editing = true;
        _tab = TabDetails;
    }

    private async Task SaveDetails()
    {
        if (_band is null)
        {
            return;
        }

        var (name, faction, subfaction, notes) = (_band.Name, _band.FactionId, _band.SubfactionId, _band.Notes);
        _band.Name = _draftName;
        _band.FactionId = _draftFaction;
        _band.SubfactionId = string.IsNullOrEmpty(_draftSubfaction) ? null : _draftSubfaction;
        _band.Notes = string.IsNullOrWhiteSpace(_draftNotes) ? null : _draftNotes.Trim();
        try
        {
            await Bands.SaveAsync(_band);
            _allBands = await Bands.GetAllAsync();
            _editing = false;
            _error = null;
        }
        catch (BandValidationException ex)
        {
            (_band.Name, _band.FactionId, _band.SubfactionId, _band.Notes) = (name, faction, subfaction, notes);
            _error = ex.Message;
        }
    }

    private async Task Duplicate()
    {
        var copy = await Bands.DuplicateAsync(Id);
        Navigation.NavigateTo($"bandas/{copy.Id}");
    }

    private async Task Delete()
    {
        await Bands.DeleteAsync(Id);
        Navigation.NavigateTo("", replace: true);
    }
}
