@page "/bandas/nueva"
@inject BandService Bands
@inject IRulesCatalog Rules
@inject Rulebook Book
@inject RosterBuilder Roster
@inject NavigationManager Navigation

<PageTitle>Nueva banda · Punkartuchera</PageTitle>

<header class="page-header">
    <a class="btn btn--icon" href="" aria-label="Volver"><Icon Path="@Icons.Back" /></a>
    <div class="page-header__title">
        <span class="page-kicker">Se buscan mataos</span>
        <h1 class="page-title distress">Nueva banda</h1>
    </div>
</header>

<form class="paper tape stack" @onsubmit="Create" novalidate>
    <label class="field">
        <span class="field__label">Nombre</span>
        <input class="field__input" id="band-name" @bind="_name" @bind:event="oninput" @bind:after="ClearNameWarning" @ref="_nameInput"
               maxlength="@BandService.MaxNameLength" placeholder="Los Oxidados de Puentechatarra" required
               aria-invalid="@(_missingName ? "true" : null)" aria-describedby="@(_missingName ? "band-name-warning" : null)" />
    </label>

    <fieldset class="field">
        <legend class="field__label">Facción</legend>
        <div class="faction-grid">
            @foreach (var faction in Rules.Factions)
            {
                <button type="button" class="faction-tile @(_factionId == faction.Id ? "is-selected" : null)"
                        aria-pressed="@(_factionId == faction.Id)" @onclick="() => SelectFaction(faction.Id)">
                    @faction.Name
                </button>
            }
        </div>
    </fieldset>

    @if (Book.FindFaction(_factionId) is { } chosen)
    {
        @if (chosen.Subfactions.Count > 0)
        {
            <fieldset class="field">
                <legend class="field__label">Subfacción <span class="muted">(opcional)</span></legend>
                <div class="faction-grid">
                    <button type="button" class="faction-tile @(_subfactionId is null ? "is-selected" : null)"
                            aria-pressed="@(_subfactionId is null)" @onclick="() => _subfactionId = null">
                        Facción base
                    </button>
                    @foreach (var subfaction in chosen.Subfactions)
                    {
                        <button type="button" class="faction-tile @(_subfactionId == subfaction.Id ? "is-selected" : null)"
                                aria-pressed="@(_subfactionId == subfaction.Id)" @onclick="() => SelectSubfaction(subfaction.Id)">
                            @subfaction.Name
                        </button>
                    }
                </div>
            </fieldset>
        }

        @if (ListsFor(chosen.Id) is { Count: > 0 } lists && _subfactionId is null)
        {
            <fieldset class="field">
                <legend class="field__label">Empezar con</legend>
                <div class="preset-list">
                    <button type="button" class="preset-option @(_listId is null ? "is-selected" : null)"
                            aria-pressed="@(_listId is null)" @onclick="() => _listId = null">
                        <span class="preset-option__name">Banda vacía</span>
                        <span class="preset-option__meta">Recluta tú a cada miembro</span>
                    </button>
                    @foreach (var list in lists)
                    {
                        <button type="button" class="preset-option @(_listId == list.Id ? "is-selected" : null)"
                                aria-pressed="@(_listId == list.Id)" @onclick="() => _listId = list.Id">
                            <span class="preset-option__name">Lista preconfigurada: @list.Name</span>
                            <span class="preset-option__meta">@list.Members.Count miembros · @list.Cost ptos · @string.Join(", ", list.Members.Select(m => m.Name ?? m.Troop))</span>
                        </button>
                    }
                </div>
            </fieldset>
        }
    }

    @if (_error is not null)
    {
        <p class="notice notice--danger">@_error</p>
    }

    <div class="actions">
        <button type="submit" class="btn btn--blood" disabled="@(_saving || _factionId is null)">
            <Icon Path="@Icons.Plus" /> Montar banda
        </button>
    </div>

    @if (_missingName)
    {
        <p class="shout" id="band-name-warning" role="alert">¡eh! ¡que no le has puesto nombre colega!</p>
    }
</form>

@code {
    private string _name = string.Empty;
    private string? _factionId;
    private string? _subfactionId;
    private string? _listId;
    private string? _error;
    private bool _saving;
    private bool _missingName;
    private ElementReference _nameInput;

    private void ClearNameWarning()
    {
        if (!string.IsNullOrWhiteSpace(_name))
        {
            _missingName = false;
        }
    }

    private IReadOnlyList<PresetList> ListsFor(string factionId) =>
        Book.Lists.Where(l => l.FactionId == factionId).ToList();

    private void SelectFaction(string id)
    {
        if (_factionId != id)
        {
            (_factionId, _subfactionId, _listId) = (id, null, null);
        }
    }

    /// <summary>Las listas oficiales son de la facción base: elegir subfacción las descarta.</summary>
    private void SelectSubfaction(string id) => (_subfactionId, _listId) = (id, null);

    private async Task Create()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name))
        {
            _missingName = true;
            await _nameInput.FocusAsync();
            return;
        }

        _saving = true;
        try
        {
            var list = Book.FindList(_listId);
            var members = list is null ? [] : Roster.FromList(list);
            var band = await Bands.CreateAsync(_name, _factionId ?? string.Empty, _subfactionId, members);
            Navigation.NavigateTo($"bandas/{band.Id}", replace: true);
        }
        catch (BandValidationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
