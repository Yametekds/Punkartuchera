@page "/bandas/nueva"
@inject BandService Bands
@inject IRulesCatalog Rules
@inject NavigationManager Navigation

<PageTitle>Nueva banda · Punkartuchera</PageTitle>

<header class="page-header">
    <a class="btn btn--icon" href="" aria-label="Volver"><Icon Path="@Icons.Back" /></a>
    <div class="page-header__title">
        <span class="page-kicker">Se buscan mataos</span>
        <h1 class="page-title distress">Nueva banda</h1>
    </div>
</header>

<form class="paper tape stack" @onsubmit="Create">
    <label class="field">
        <span class="field__label">Nombre</span>
        <input class="field__input" @bind="_name" @bind:event="oninput" maxlength="@BandService.MaxNameLength" placeholder="Los Oxidados de Puentechatarra" required />
    </label>

    <fieldset class="field">
        <legend class="field__label">Facción</legend>
        <div class="faction-grid">
            @foreach (var faction in Rules.Factions)
            {
                <button type="button" class="faction-tile @(_factionId == faction.Id ? "is-selected" : null)"
                        aria-pressed="@(_factionId == faction.Id)" @onclick="() => _factionId = faction.Id">
                    @faction.Name
                </button>
            }
        </div>
    </fieldset>

    @if (_error is not null)
    {
        <p class="notice notice--danger">@_error</p>
    }

    <div class="actions">
        <button type="submit" class="btn btn--blood" disabled="@(_saving || string.IsNullOrWhiteSpace(_name) || _factionId is null)">
            <Icon Path="@Icons.Plus" /> Montar banda
        </button>
    </div>
</form>

@code {
    private string _name = string.Empty;
    private string? _factionId;
    private string? _error;
    private bool _saving;

    private async Task Create()
    {
        _error = null;
        _saving = true;
        try
        {
            var band = await Bands.CreateAsync(_name, _factionId ?? string.Empty);
            Navigation.NavigateTo($"bandas/{band.Id}", replace: true);
        }
        catch (BandValidationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
