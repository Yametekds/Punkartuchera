@page "/bandas/{BandId:guid}/miembro/nuevo"
@page "/bandas/{BandId:guid}/miembro/{MemberId:guid}"
@using Punkartuchera.Core.Serialization
@using Punkartuchera.Core.Storage
@implements IAsyncDisposable
@inject BandService Bands
@inject IRulesCatalog Rules
@inject RosterBuilder Roster
@inject UnitCostCalculator Costs
@inject LoadoutAdvisor Advisor
@inject IPhotoStore Photos
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "Nuevo miembro" : _member?.Name) · Punkartuchera</PageTitle>

@if (_loading)
{
    <p class="muted">Cargando…</p>
}
else if (_band is null || _member is null || _band.IsReadOnly)
{
    <section class="punk-empty">
        <h1>No se puede editar este miembro</h1>
        <a class="btn btn--primary" href="">Volver a las bandas</a>
    </section>
}
else
{
    <header class="page-header">
        <a class="btn btn--icon" href="@BandHref" aria-label="Volver"><Icon Path="@Icons.Back" /></a>
        <div class="page-header__title">
            <span class="chip chip--faction">@_band.Name</span>
            <h1 class="page-title distress">@(IsNew ? "Reclutar" : "Editar ficha")</h1>
        </div>
    </header>

    @* Sin <form>: Enter en los campos de etiquetas no debe guardar el miembro. *@
    <div class="stack">
        @if (IsNew)
        {
            <section class="paper recruit-picker">
                <label class="field">
                    <span class="field__label">Sacar del reglamento</span>
                    <select class="field__input" value="@_choiceKey" @onchange="PickTroop">
                        <option value="">A mano (ficha en blanco)</option>
                        @foreach (var group in _choices.GroupBy(c => c.Group))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var choice in group)
                                {
                                    <option value="@choice.Key">@ChoiceLabel(choice)</option>
                                }
                            </optgroup>
                        }
                    </select>
                </label>
                @if (_picked is not null)
                {
                    <p class="recruit-picker__summary">
                        Perfil, coste base, equipo fijo y reglas cargados. Lo que compres aparte se suma solo al coste.
                        <a href="@RulesHref(_picked)">Ver su ficha en las reglas</a>
                    </p>
                }
            </section>
        }

        <section class="card member-editor__photo">
            <MiniPortrait Photo="_member.Photo" Alt="@_member.Name" Size="lg" />
            <PhotoPicker @bind-Value="_member.Photo" OnPhotoStored="key => _newPhotos.Add(key)" OfficialPhotos="OfficialPhotos" />
            @if (_member.Photo is { Source: PhotoSource.Official })
            {
                <p class="official-grid__credit">Foto oficial de la miniatura (Bad Roll Games). Puedes cambiarla por la tuya.</p>
            }
        </section>

        <section class="paper stack">
            <label class="field">
                <span class="field__label">Nombre</span>
                <input class="field__input" @bind="_member.Name" @bind:event="oninput" maxlength="60" placeholder="Morro Chungo" required />
            </label>
            <label class="field">
                <span class="field__label">Tipo</span>
                <input class="field__input" list="member-roles" @bind="_member.Role" @bind:after="Recalculate" maxlength="40" placeholder="Elige o escribe" />
                <datalist id="member-roles">
                    @foreach (var role in Rules.Roles)
                    {
                        <option value="@role"></option>
                    }
                </datalist>
            </label>
            <label class="field field--narrow">
                <span class="field__label">Coste base</span>
                <input class="field__input" type="number" min="0" value="@_member.BaseCost" @onchange="SetBaseCost" />
            </label>
        </section>

        <section class="paper stack">
            <h2 class="section-title">Atributos</h2>
            <PlaceholderNotice />
            <div class="stat-grid">
                @foreach (var stat in Rules.Stats)
                {
                    <Stepper Label="@stat.Abbreviation" Min="stat.Min" Max="stat.Max" Compact="true"
                             Value="_member.GetStat(stat.Key, stat.Default)"
                             ValueChanged="value => _member.Stats[stat.Key] = value" />
                }
            </div>
            <div class="ammo-stepper">
                <Stepper Label="Balas" Min="0" Max="99" @bind-Value="_member.Ammo" @bind-Value:after="Recalculate" />
                <span class="ammo-stepper__price">@_cost.BulletPrice ptos por bala</span>
            </div>
        </section>

        <section class="paper stack loadout">
            <div class="loadout__head">
                <h2 class="section-title">Equipo</h2>
                <button type="button" class="btn btn--ghost loadout__add" @onclick="() => _picker = LoadoutSlot.Gear">Añadir equipo</button>
            </div>
            @if (_loadout.Limit is { } limit)
            {
                <p class="loadout__limit">
                    <strong>Armas: @_loadout.Weapons de @limit.Max</strong> · @limit.Text
                </p>
            }
            @if (_loadout.Closed)
            {
                <p class="loadout__limit">Equipo cerrado: viene incluido en su coste. Solo se le compran balas.</p>
            }
            <TagEditor Items="_gearNames" AllowTyping="false" ItemsChanged="Recalculate" />
            @foreach (var warning in _loadout.Warnings)
            {
                <p class="notice notice--warning"><span>@warning</span></p>
            }

            <div class="loadout__head">
                <h2 class="section-title">Habilidades</h2>
                <button type="button" class="btn btn--ghost loadout__add" @onclick="() => _picker = LoadoutSlot.Skill">Añadir habilidad</button>
            </div>
            <TagEditor Items="_member.Skills" AllowTyping="false" ItemsChanged="Recalculate" />
        </section>

        @if (_picker is { } slot)
        {
            var isSkill = slot == LoadoutSlot.Skill;
            <LoadoutPicker Options="@(isSkill ? _loadout.Skills : _loadout.Gear)"
                           Title="@(isSkill ? "Añadir habilidad" : "Añadir equipo")"
                           Intro="@PickerIntro(isSkill)"
                           ManualPlaceholder="@(isSkill ? "Nueva habilidad" : "Nuevo equipo")"
                           OnPick="Buy" OnManual="name => AddManual(name, isSkill)" OnClose="() => _picker = null" />
        }

        <section class="paper stack cost-sheet">
            <h2 class="section-title">Coste de la miniatura</h2>
            <ul class="cost-sheet__lines">
                @foreach (var line in _cost.Lines.Where(l => l.Kind != CostLineKind.Unpriced))
                {
                    <li class="cost-sheet__line cost-sheet__line--@line.Kind.ToString().ToLowerInvariant()">
                        <span>@LineLabel(line)</span>
                        <span class="cost-sheet__points">@LinePoints(line)</span>
                    </li>
                }
            </ul>
        </section>

        <section class="paper stack">
            <label class="field">
                <span class="field__label">Notas</span>
                <textarea class="field__input" rows="3" @bind="_member.Notes"></textarea>
            </label>
        </section>

        @if (_error is not null)
        {
            <p class="notice notice--danger">@_error</p>
        }

        <div class="actions actions--sticky">
            <span class="cost-total" aria-live="polite"><strong>@_cost.Total</strong> ptos</span>
            <button type="button" class="btn btn--primary" disabled="@_saving" @onclick="Save">Guardar</button>
            <a class="btn btn--ghost" href="@BandHref">Cancelar</a>
            @if (!IsNew)
            {
                <ConfirmButton Text="Borrar" OnConfirm="Delete" />
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid BandId { get; set; }

    [Parameter] public Guid? MemberId { get; set; }

    private Band? _band;
    private Miniature? _member;
    private List<string> _gearNames = [];
    private readonly List<string> _newPhotos = [];
    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string? _error;

    private IReadOnlyList<TroopChoice> _choices = [];
    private Loadout _loadout = new([], [], null, 0, false, false, []);
    private LoadoutSlot? _picker;
    private UnitCost _cost = new([], UnitCostCalculator.DefaultBulletPrice);
    private TroopChoice? _picked;
    private string _choiceKey = string.Empty;

    private bool IsNew => MemberId is null;

    private IReadOnlyList<OfficialMini> OfficialPhotos =>
        _member is null ? [] : Roster.PhotosFor(_band?.FactionId, _member.Role);

    private string BandHref => $"bandas/{BandId}";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _band = await Bands.GetAsync(BandId);
        if (_band is not null)
        {
            var existing = MemberId is { } id ? _band.FindMember(id) : null;
            _member = IsNew
                ? Bands.NewMember(Rules.Roles.FirstOrDefault() ?? string.Empty)
                : existing is null ? null : Clone(existing);
            _gearNames = _member?.Gear.Select(g => g.Name).ToList() ?? [];
            _choices = Roster.ChoicesFor(_band.FactionId, _band.SubfactionId);
        }

        Recalculate();

        _loading = false;
    }

    /// <summary>Rellena la ficha con una tropa, personalidad o mercenario del reglamento, conservando la foto.</summary>
    private void PickTroop(ChangeEventArgs e)
    {
        if (_member is null)
        {
            return;
        }

        _choiceKey = e.Value?.ToString() ?? string.Empty;
        _picked = _choices.FirstOrDefault(c => c.Key == _choiceKey) ?? Roster.FindChoice(_choiceKey);
        var filled = _picked is null
            ? Bands.NewMember(Rules.Roles.FirstOrDefault() ?? string.Empty)
            : Roster.FromTroop(_picked.Troop, _picked.Owner.ParentId ?? _picked.Owner.Id);
        filled.Id = _member.Id;
        if (_picked?.Label is { } label)
        {
            // La subfacción la llama de otra forma; el papel sigue siendo la tropa del reglamento.
            filled.Name = label;
        }

        // La foto oficial acompaña a la tropa elegida, pero una foto propia no se pisa.
        if (_member.Photo is not null and not { Source: PhotoSource.Official })
        {
            filled.Photo = _member.Photo;
        }

        filled.Ammo = _member.Ammo;
        _member = filled;
        _gearNames = _member.Gear.Select(g => g.Name).ToList();
        Recalculate();
    }

    /// <summary>Vuelve a calcular el coste y las compras posibles con lo que hay ahora en la ficha.</summary>
    private void Recalculate()
    {
        if (_member is null || _band is null)
        {
            return;
        }

        SyncGear();
        _cost = Costs.Calculate(_member, _band.FactionId, _band.SubfactionId);
        _loadout = Advisor.Advise(_member, _band.FactionId, _band.SubfactionId, _band.Members);
    }

    private void SetBaseCost(ChangeEventArgs e)
    {
        if (_member is null)
        {
            return;
        }

        if (_member.BaseCost is null)
        {
            // Ficha de antes: lo que ya llevaba queda dentro del coste base.
            _member.Included = [.. _gearNames, .. _member.Skills];
        }

        _member.BaseCost = int.TryParse(e.Value?.ToString(), out var value) ? Math.Max(0, value) : 0;
        Recalculate();
    }

    /// <summary>Añade una compra del reglamento. Se puede seguir añadiendo con la ventana abierta.</summary>
    private void Buy(LoadoutOption option)
    {
        if (_member is null)
        {
            return;
        }

        LoadoutAdvisor.Add(option.Slot == LoadoutSlot.Skill ? _member.Skills : _gearNames, option);
        Recalculate();
    }

    private void AddManual(string name, bool isSkill)
    {
        if (_member is null)
        {
            return;
        }

        var list = isSkill ? _member.Skills : _gearNames;
        if (!list.Contains(name, StringComparer.OrdinalIgnoreCase))
        {
            list.Add(name);
        }

        _picker = null;
        Recalculate();
    }

    private string? PickerIntro(bool isSkill)
    {
        if (_loadout.Closed)
        {
            return "Personalidades y mercenarios llevan el equipo cerrado: el reglamento no les deja comprar nada más.";
        }

        var options = isSkill ? _loadout.Skills : _loadout.Gear;
        if (options.Count == 0)
        {
            return isSkill ? "Su facción no tiene mejoras con precio para comprar." : "El reglamento no le da nada más para comprar.";
        }

        return _loadout.FromTroopList
            ? $"Lo que el reglamento deja comprar a {_member?.Role}."
            : "Sin tipo de tropa del reglamento: se muestra todo lo que tiene precio en su facción.";
    }

    private static string LineLabel(CostLine line) => line.Kind switch
    {
        CostLineKind.Ammo => $"{line.Quantity} {(line.Quantity == 1 ? "bala" : "balas")}",
        CostLineKind.Included => $"{line.Label} (incluido)",
        _ => line.Label,
    };

    private static string LinePoints(CostLine line) => line.Kind switch
    {
        CostLineKind.Base => line.Points.ToString(),
        CostLineKind.Included => "0",
        _ => $"+{line.Points}",
    };

    private void SyncGear()
    {
        if (_member is null)
        {
            return;
        }

        var notesByName = _member.Gear.GroupBy(g => g.Name).ToDictionary(g => g.Key, g => g.First().Notes);
        _member.Gear = _gearNames
            .Select(name => new Equipment { Name = name, Notes = notesByName.GetValueOrDefault(name) })
            .ToList();
    }

    private static string ChoiceLabel(TroopChoice choice) => choice.Label is null
        ? $"{choice.Troop.Name} · {choice.Troop.Cost} ptos"
        : $"{choice.Label} ({choice.Troop.Name}) · {choice.Troop.Cost} ptos";

    private static string RulesHref(TroopChoice choice) => choice.Owner.IsSubfaction
        ? $"reglas/faccion/{choice.Owner.ParentId}/subfaccion/{choice.Owner.Id}#{choice.Troop.Slug}"
        : $"reglas/faccion/{choice.Owner.Id}/miembros#{choice.Troop.Slug}";

    private async Task Save()
    {
        if (_band is null || _member is null)
        {
            return;
        }

        _error = null;
        _saving = true;
        try
        {
            SyncGear();
            _cost = Costs.Apply(_member, _band.FactionId, _band.SubfactionId);

            await Bands.SaveMemberAsync(_band, _member);
            _saved = true;
            await DiscardUnusedPhotosAsync(_member.Photo);
            Navigation.NavigateTo(BandHref);
        }
        catch (BandValidationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Delete()
    {
        if (_band is null || MemberId is not { } id)
        {
            return;
        }

        await Bands.RemoveMemberAsync(_band, id);
        Navigation.NavigateTo(BandHref, replace: true);
    }

    /// <summary>Borra las fotos hechas en esta pantalla que no han quedado asignadas.</summary>
    private async Task DiscardUnusedPhotosAsync(PhotoRef? keep)
    {
        foreach (var key in _newPhotos.Where(k => keep is not { Source: PhotoSource.Stored } || keep.Key != k))
        {
            await Photos.DeleteAsync(key);
        }

        _newPhotos.Clear();
    }

    public async ValueTask DisposeAsync()
    {
        if (!_saved)
        {
            await DiscardUnusedPhotosAsync(null);
        }
    }

    private static Miniature Clone(Miniature member)
    {
        var wrapper = new Band { Members = [member] };
        return BandSerializer.Clone(wrapper).Members[0];
    }
}
