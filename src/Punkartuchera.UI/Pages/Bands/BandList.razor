@page "/"
@page "/bandas"
@inject BandService Bands
@inject IRulesCatalog Rules
@inject BandExchangeService Exchange
@inject NavigationManager Navigation

<PageTitle>Bandas · Punkartuchera</PageTitle>

<header class="page-header">
    <div class="page-header__title">
        <span class="page-kicker">Tu chusma, tus normas</span>
        <h1 class="page-title distress">Tus bandas</h1>
    </div>
    <label class="btn btn--ghost" title="Abre el archivo .punkband que te ha pasado el rival">
        <Icon Path="@Icons.Inbox" /> Cargar rival
        <InputFile class="visually-hidden" OnChange="ImportRival" />
    </label>
</header>

@if (_importing)
{
    <p class="muted" role="status">Cacheando a la banda rival…</p>
}

@if (_importError is not null)
{
    <p class="notice notice--danger">@_importError</p>
}

<PlaceholderNotice />

@if (_bands is null)
{
    <p class="muted">Rebuscando en la chatarra…</p>
}
else if (_bands.Count == 0)
{
    <section class="punk-empty">
        <Icon Path="@Icons.Band" Class="icon--huge" />
        <h2>El páramo está vacío</h2>
        <p>Ni una banda, tron. Monta la primera y sal a repartir.</p>
        <a class="btn btn--primary" href="bandas/nueva"><Icon Path="@Icons.Plus" /> Montar banda</a>
    </section>
}
else
{
    @foreach (var group in _bands.GroupBy(b => b.Ownership))
    {
        <h2 class="section-title">@(group.Key == BandOwnership.Own ? "Las tuyas" : "Rivales")</h2>
        <div class="card-grid">
            @foreach (var band in group)
            {
                <a class="paper tape band-card @(band.IsReadOnly ? "band-card--rival" : null)" href="@($"bandas/{band.Id}")">
                    <div class="band-card__head">
                        <span class="stamp">@FactionName(band)</span>
                        @if (band.IsReadOnly)
                        {
                            <span class="stamp stamp--ink"><Icon Path="@Icons.Lock" /> Rival</span>
                        }
                    </div>
                    <h3 class="band-card__name">@band.Name</h3>
                    <div class="band-card__portraits">
                        @foreach (var member in band.Members.Take(6))
                        {
                            <MiniPortrait Photo="member.Photo" Alt="@member.Name" Size="sm" />
                        }
                        @if (band.Members.Count > 6)
                        {
                            <span class="portrait portrait--sm portrait--more">+@(band.Members.Count - 6)</span>
                        }
                    </div>
                    <p class="band-card__meta">@MembersLabel(band.Members.Count) · @(band.IsReadOnly ? "? balas" : $"{band.Members.Sum(m => m.Ammo)} balas")</p>
                </a>
            }
        </div>
    }
}

<a class="btn btn--blood fab" href="bandas/nueva"><Icon Path="@Icons.Plus" /> Nueva banda</a>

@code {
    private IReadOnlyList<Band>? _bands;
    private bool _importing;
    private string? _importError;

    protected override async Task OnInitializedAsync() => _bands = await Bands.GetAllAsync();

    private async Task ImportRival(InputFileChangeEventArgs e)
    {
        _importError = null;
        _importing = true;
        try
        {
            await using var stream = e.File.OpenReadStream(BandExchangeService.MaxFileBytes);
            var band = await Exchange.ImportAsync(stream);
            Navigation.NavigateTo($"bandas/{band.Id}");
        }
        catch (BandExchangeException ex)
        {
            _importError = ex.Message;
        }
        catch (IOException)
        {
            _importError = "No se pudo leer el archivo. ¿Seguro que es una banda y no pesa una barbaridad?";
        }
        finally
        {
            _importing = false;
        }
    }

    private string FactionName(Band band) => Rules.FindFaction(band.FactionId)?.Name ?? "Sin facción";

    private static string MembersLabel(int count) => count == 1 ? "1 miembro" : $"{count} miembros";
}
