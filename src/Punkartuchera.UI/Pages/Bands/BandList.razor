@page "/"
@page "/bandas"
@inject BandService Bands
@inject IRulesCatalog Rules

<PageTitle>Bandas · Punkartuchera</PageTitle>

<header class="page-header">
    <h1 class="page-title">Tus bandas</h1>
    <a class="btn btn--primary" href="bandas/nueva"><Icon Path="@Icons.Plus" /> Nueva banda</a>
</header>

<PlaceholderNotice />

@if (_bands is null)
{
    <p class="muted">Cargando bandas…</p>
}
else if (_bands.Count == 0)
{
    <section class="punk-empty">
        <Icon Path="@Icons.Band" Class="icon--huge" />
        <h2>El páramo está vacío</h2>
        <p>Crea tu primera banda y empieza a reclutar.</p>
        <a class="btn btn--primary" href="bandas/nueva"><Icon Path="@Icons.Plus" /> Crear banda</a>
    </section>
}
else
{
    @foreach (var group in _bands.GroupBy(b => b.Ownership))
    {
        <h2 class="section-title">@(group.Key == BandOwnership.Own ? "Propias" : "Rivales")</h2>
        <div class="card-grid">
            @foreach (var band in group)
            {
                <a class="card band-card @(band.IsReadOnly ? "band-card--rival" : null)" href="@($"bandas/{band.Id}")">
                    <div class="band-card__head">
                        <span class="chip chip--faction">@FactionName(band)</span>
                        @if (band.IsReadOnly)
                        {
                            <span class="chip chip--rival"><Icon Path="@Icons.Lock" /> Rival</span>
                        }
                    </div>
                    <h3 class="band-card__name">@band.Name</h3>
                    <div class="band-card__portraits">
                        @foreach (var member in band.Members.Take(5))
                        {
                            <MiniPortrait Photo="member.Photo" Alt="@member.Name" Size="sm" />
                        }
                        @if (band.Members.Count > 5)
                        {
                            <span class="portrait portrait--sm portrait--more">+@(band.Members.Count - 5)</span>
                        }
                    </div>
                    <p class="band-card__meta">@MembersLabel(band.Members.Count)</p>
                </a>
            }
        </div>
    }
}

@code {
    private IReadOnlyList<Band>? _bands;

    protected override async Task OnInitializedAsync() => _bands = await Bands.GetAllAsync();

    private string FactionName(Band band) => Rules.FindFaction(band.FactionId)?.Name ?? "Sin facción";

    private static string MembersLabel(int count) => count == 1 ? "1 miembro" : $"{count} miembros";
}
