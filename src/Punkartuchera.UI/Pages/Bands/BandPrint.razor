@page "/bandas/{Id:guid}/pdf"
@layout PrintLayout
@inject BandService Bands
@inject IRulesCatalog Rules
@inject Rulebook Book
@inject GearLookup Lookup
@inject UnitRules UnitRules
@inject CloseCombat CloseCombat
@inject LoadoutModifiers LoadoutModifiers
@inject MemberArmor MemberArmor
@inject PhotoUrlProvider PhotoUrls
@inject IJSRuntime JS

@* Hojas de la banda para imprimir o guardar en PDF desde el diálogo de impresión del navegador. *@
<PageTitle>@(_band?.Name ?? "Banda")</PageTitle>

<div class="band-print">
    <div class="print-toolbar">
        <a class="btn btn--ghost" href="@(_band is null ? "" : $"bandas/{_band.Id}")"><Icon Path="@Icons.Back" /> Volver</a>
        @if (_band is not null)
        {
            <button type="button" class="btn btn--blood" @onclick="Print"><Icon Path="@Icons.Document" /> Guardar en PDF</button>
            <p class="print-toolbar__hint">En el diálogo de impresión elige «Guardar como PDF» como impresora.</p>
        }
    </div>

    @if (_loading)
    {
        <p class="print-toolbar__hint">Cargando banda…</p>
    }
    else if (_band is null)
    {
        <p class="print-toolbar__hint">Esta banda ya no existe.</p>
    }
    else
    {
        @* La tabla repite su cabecera y su pie vacíos en cada hoja: dejan el margen y el hueco del pie de página. *@
        <table class="print-frame" role="presentation">
        <thead><tr><td><div class="print-frame__top"></div></td></tr></thead>
        <tfoot><tr><td><div class="print-frame__bottom"></div></td></tr></tfoot>
        <tbody><tr><td>
        <article class="print-doc">
            <header class="print-cover">
                <p class="print-cover__kicker">Banda de @FactionName@(SubfactionName is null ? "" : $" · {SubfactionName}")</p>
                <h1 class="print-cover__name">@_band.Name</h1>
                <dl class="print-cover__facts">
                    <div><dt>Miembros</dt><dd>@_band.Members.Count</dd></div>
                    @if (_band.Cost is { } cost)
                    {
                        <div><dt>Coste</dt><dd>@cost</dd></div>
                    }
                    @if (!_band.IsReadOnly)
                    {
                        <div><dt>Balas</dt><dd>@_band.Members.Sum(m => m.Ammo)</dd></div>
                    }
                </dl>
                @if (_band.IsReadOnly)
                {
                    <p class="print-cover__note">Banda rival: sus balas y el coste de cada miembro no se conocen.</p>
                }
            </header>

            @if (_band.Members.Count > 0)
            {
                <section class="print-section">
                    <h2 class="print-section__title">Lista de la banda</h2>
                    <table class="print-table print-roster">
                        <thead>
                            <tr>
                                <th scope="col">Miembro</th>
                                <th scope="col">Tipo</th>
                                @if (!_band.IsReadOnly)
                                {
                                    <th scope="col" class="num">Balas</th>
                                    <th scope="col" class="num">Coste</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in _band.Members)
                            {
                                <tr>
                                    <td><strong>@member.Name</strong></td>
                                    <td>@member.Role</td>
                                    @if (!_band.IsReadOnly)
                                    {
                                        <td class="num">@member.Ammo</td>
                                        <td class="num">@(member.Cost?.ToString() ?? "–")</td>
                                    }
                                </tr>
                            }
                        </tbody>
                        @if (!_band.IsReadOnly && _band.Cost is { } total)
                        {
                            <tfoot>
                                <tr>
                                    <th scope="row" colspan="2">Total</th>
                                    <td class="num">@_band.Members.Sum(m => m.Ammo)</td>
                                    <td class="num">@total</td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </section>
            }

            @foreach (var faction in _factionRules)
            {
                <section class="print-section print-section--rules">
                    <h2 class="print-section__title">Reglas especiales de @faction.Name</h2>
                    <dl class="print-rules print-rules--faction">
                        @foreach (var rule in faction.Rules)
                        {
                            <div class="print-rules__item">
                                <dt>@rule.Name</dt>
                                <dd>
                                    @rule.Text
                                    @if (rule.Table is not null)
                                    {
                                        <table class="print-table print-rules__table">
                                            <thead><tr>@foreach (var column in rule.Table.Columns) { <th scope="col">@column</th> }</tr></thead>
                                            <tbody>
                                                @foreach (var row in rule.Table.Rows)
                                                {
                                                    <tr>@foreach (var cell in row) { <td>@cell</td> }</tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </dd>
                            </div>
                        }
                    </dl>
                </section>
            }

            @if (_brief is { Restrictions.Count: > 0 })
            {
                <section class="print-section">
                    <h2 class="print-section__title">Límites de la banda</h2>
                    <ul class="print-list">
                        @foreach (var restriction in _brief.Restrictions)
                        {
                            <li>@restriction</li>
                        }
                    </ul>
                </section>
            }

            @foreach (var sheet in _sheets)
            {
                var member = sheet.Member;
                <section class="print-profile">
                    <header class="print-profile__head">
                        <div class="print-profile__title">
                            <h2 class="print-profile__name">@member.Name</h2>
                            @if (!string.IsNullOrEmpty(member.Role) && !string.Equals(member.Role, member.Name, StringComparison.CurrentCultureIgnoreCase))
                            {
                                <span class="print-profile__role">@member.Role</span>
                            }
                        </div>
                        @if (!_band.IsReadOnly && member.Cost is { } memberCost)
                        {
                            <span class="print-profile__cost">@memberCost <small>ptos</small></span>
                        }
                    </header>

                    <div class="print-profile__main">
                        @if (sheet.PhotoUrl is not null && !_brokenPhotos.Contains(member.Id))
                        {
                            <img class="print-profile__photo" src="@sheet.PhotoUrl" alt="@member.Name" @onerror="() => _brokenPhotos.Add(member.Id)" />
                        }
                        <div class="print-profile__line">
                        <table class="print-stats">
                            <thead>
                                <tr>
                                    @foreach (var stat in Rules.Stats)
                                    {
                                        <th scope="col" title="@stat.Name">@stat.Abbreviation</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    @foreach (var stat in Rules.Stats)
                                    {
                                        var gear = sheet.Modifiers.GetValueOrDefault(stat.Key);
                                        <td>
                                            @Math.Max(0, member.GetStat(stat.Key, stat.Default) + (gear?.Pending ?? 0))
                                            @if (gear is { Delta: not 0 })
                                            {
                                                <span class="print-stats__mod">@Signed(gear.Delta)</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                        @* Blindaje en una chapa remachada y balas dentro de una bala, como fichas sobre la hoja. *@
                        <svg class="print-token print-token--armor" viewBox="0 0 60 60" role="img" aria-label="Blindaje @sheet.Armor.Value">
                            <defs>
                                <linearGradient id="plate-@member.Id" x1="0" y1="0" x2="1" y2="1">
                                    <stop offset="0" stop-color="#6d6a64" />
                                    <stop offset=".45" stop-color="#3b3935" />
                                    <stop offset="1" stop-color="#1f1d1a" />
                                </linearGradient>
                                <radialGradient id="rivet-@member.Id" cx=".35" cy=".35" r=".7">
                                    <stop offset="0" stop-color="#d9d3c7" />
                                    <stop offset=".5" stop-color="#7d776c" />
                                    <stop offset="1" stop-color="#2a2723" />
                                </radialGradient>
                            </defs>
                            <path d="M6 2h48l4 4v48l-4 4H6l-4-4V6z" fill="url(#plate-@member.Id)" stroke="#0d0b09" stroke-width="2" />
                            <path d="M7 5h46l2 2v46l-2 2H7l-2-2V7z" fill="none" stroke="rgba(255,255,255,.18)" stroke-width="1" />
                            @foreach (var (x, y) in Rivets)
                            {
                                <circle cx="@x" cy="@y" r="3.2" fill="url(#rivet-@member.Id)" stroke="#0d0b09" stroke-width=".8" />
                            }
                            <text x="30" y="17.5" text-anchor="middle" class="print-token__label">BL</text>
                            <text x="30" y="46" text-anchor="middle" class="print-token__value print-token__value--armor">@sheet.Armor.Value</text>
                        </svg>
                        @if (!_band.IsReadOnly)
                        {
                            <svg class="print-token print-token--ammo" viewBox="0 0 34 72" role="img" aria-label="@member.Ammo balas">
                                <defs>
                                    <linearGradient id="brass-@member.Id" x1="0" y1="0" x2="1" y2="0">
                                        <stop offset="0" stop-color="#8a5a12" />
                                        <stop offset=".35" stop-color="#e8b85a" />
                                        <stop offset=".6" stop-color="#c58b2a" />
                                        <stop offset="1" stop-color="#6e4610" />
                                    </linearGradient>
                                    <linearGradient id="lead-@member.Id" x1="0" y1="0" x2="1" y2="0">
                                        <stop offset="0" stop-color="#7a3a1c" />
                                        <stop offset=".35" stop-color="#d07a4a" />
                                        <stop offset="1" stop-color="#5a2410" />
                                    </linearGradient>
                                </defs>
                                <path d="M5 26C5 13 11 4 17 1c6 3 12 12 12 25z" fill="url(#lead-@member.Id)" stroke="#0d0b09" stroke-width="1.6" />
                                <path d="M3 26h28v40H3z" fill="url(#brass-@member.Id)" stroke="#0d0b09" stroke-width="1.6" />
                                <path d="M2 66h30v5H2z" fill="url(#brass-@member.Id)" stroke="#0d0b09" stroke-width="1.6" />
                                <text x="17" y="54" text-anchor="middle" class="print-token__value print-token__value--ammo">@member.Ammo</text>
                            </svg>
                        }
                        </div>
                        @if (ProfileNotes(sheet) is { Count: > 0 } notes)
                        {
                            <p class="print-profile__mods">@string.Join(" · ", notes)</p>
                        }
                    </div>

                    @if (member.Gear.Count > 0)
                    {
                        <h3 class="print-profile__label">Equipo</h3>
                        <table class="print-table print-gear">
                            <tbody>
                                @foreach (var item in member.Gear)
                                {
                                    var info = Lookup.Find(item.Name, _band.FactionId);
                                    <tr>
                                        <th scope="row">
                                            @item.Name
                                            @if (info is not null)
                                            {
                                                <small>@RuleSheet.KindLabel(info.Kind)</small>
                                            }
                                        </th>
                                        <td>
                                            @(info?.Summary ?? "No está en el reglamento.")
                                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                                            {
                                                <em class="print-gear__notes">@item.Notes</em>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (sheet.Melee.Count > 0)
                    {
                        <h3 class="print-profile__label">En cuerpo a cuerpo</h3>
                        <ul class="print-list">
                            @foreach (var fallback in sheet.Melee)
                            {
                                <li>
                                    <strong>@(fallback.From is null ? "" : $"{fallback.From} como ")@fallback.Profile.Name.ToLowerInvariant()</strong>:
                                    C @(fallback.Profile.Combat ?? "+0") · F @fallback.Profile.Strength · Pen @fallback.Profile.Penetration.
                                    <span class="print-muted">@fallback.Explanation</span>
                                </li>
                            }
                        </ul>
                    }

                    @if (member.Skills.Count > 0)
                    {
                        <h3 class="print-profile__label">Habilidades</h3>
                        <p class="print-tags">@string.Join(" · ", member.Skills)</p>
                    }

                    @if (sheet.Rules.Count > 0)
                    {
                        <h3 class="print-profile__label">Reglas especiales</h3>
                        <dl class="print-rules">
                            @foreach (var rule in sheet.Rules)
                            {
                                <div class="print-rules__item">
                                    <dt>@rule.Name@(rule.From is null ? null : $" ({rule.From})")</dt>
                                    <dd>
                                        @rule.Text
                                        @if (rule.Table is not null)
                                        {
                                            <table class="print-table print-rules__table">
                                                <thead><tr>@foreach (var column in rule.Table.Columns) { <th scope="col">@column</th> }</tr></thead>
                                                <tbody>
                                                    @foreach (var row in rule.Table.Rows)
                                                    {
                                                        <tr>@foreach (var cell in row) { <td>@cell</td> }</tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </dd>
                                </div>
                            }
                        </dl>
                    }

                    @if (!string.IsNullOrWhiteSpace(member.Notes))
                    {
                        <h3 class="print-profile__label">Notas</h3>
                        <p class="print-notes">@member.Notes</p>
                    }
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(_band.Notes))
            {
                <section class="print-section">
                    <h2 class="print-section__title">Notas de la banda</h2>
                    <p class="print-notes">@_band.Notes</p>
                </section>
            }
        </article>
        </td></tr></tbody>
        </table>
    }

    <footer class="print-footer">
        Hecho en Punkartuchera. Proyecto sin fines de lucro de Fernando Hernández ·
        <a href="@RepositoryUrl">github.com/Yametekds/Punkartuchera</a>
    </footer>
</div>

@code {
    private const string RepositoryUrl = "https://github.com/Yametekds/Punkartuchera";

    [Parameter] public Guid Id { get; set; }

    private Band? _band;
    private bool _loading = true;
    private FactionBrief? _brief;

    /// <summary>Reglas de la facción madre y, si la hay, las de la subfacción, con su texto entero.</summary>
    private IReadOnlyList<FactionRules> _factionRules = [];
    private IReadOnlyList<MemberSheet> _sheets = [];

    /// <summary>Fotos que no se han podido cargar (sin conexión con la tienda): mejor sin foto que un hueco roto.</summary>
    private readonly HashSet<Guid> _brokenPhotos = [];

    private string FactionName => Rules.FindFaction(_band?.FactionId)?.Name ?? "Sin facción";

    private string? SubfactionName => Book.FindSubfaction(_band?.SubfactionId)?.Name;

    private sealed record MemberSheet(
        Miniature Member,
        string? PhotoUrl,
        IReadOnlyList<UnitRule> Rules,
        IReadOnlyList<MeleeFallback> Melee,
        IReadOnlyDictionary<string, StatAdjustment> Modifiers,
        ArmorRating Armor);

    private static readonly (int X, int Y)[] Rivets = [(9, 9), (51, 9), (9, 51), (51, 51)];

    /// <summary>"Agilidad −1 por Cañón de mano (Armatoste)", "Blindaje 5 por Armadura quitinosa", lo situacional.</summary>
    private List<string> ProfileNotes(MemberSheet sheet)
    {
        var notes = sheet.Modifiers
            .Select(m => $"{StatName(m.Key)} {Signed(m.Value.Delta)} por {string.Join(", ", m.Value.Sources)}")
            .ToList();
        if (sheet.Armor.Sources.Count > 0)
        {
            notes.Add($"Blindaje {sheet.Armor.Value} por {string.Join(", ", sheet.Armor.Sources)}");
        }

        notes.AddRange(sheet.Armor.Situational);
        return notes;
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _band = await Bands.GetAsync(Id);
        if (_band is not null)
        {
            var sheets = new List<MemberSheet>();
            foreach (var member in _band.Members)
            {
                sheets.Add(new MemberSheet(
                    member,
                    await PhotoUrls.GetUrlAsync(member.Photo),
                    UnitRules.For(member, _band.FactionId, _band.SubfactionId),
                    CloseCombat.For(member, _band.FactionId),
                    LoadoutModifiers.For(member, _band.FactionId, _band.SubfactionId),
                    MemberArmor.For(member, _band.FactionId, _band.SubfactionId)));
            }

            _sheets = sheets;
            _brief = FactionBrief.For(Book, _band.FactionId, _band.SubfactionId);
            _factionRules = new[] { _brief?.Parent, _brief?.Faction }
                .OfType<FactionRules>()
                .Where(f => f.Rules.Count > 0)
                .ToList();
        }

        _loading = false;
    }

    private string StatName(string key) => Rules.Stats.FirstOrDefault(s => string.Equals(s.Key, key, StringComparison.OrdinalIgnoreCase))?.Name ?? key;

    private static string Signed(int value) => value > 0 ? $"+{value}" : $"−{-value}";

    private async Task Print() => await JS.InvokeVoidAsync("print");
}
