@page "/partida"
@using Punkartuchera.Core.Matches
@using Punkartuchera.Relay.Contracts
@implements IDisposable
@inject IMatchService Matches
@inject BandService Bands
@inject IJSRuntime JS
@inject MatchAidCatalog AidCatalog
@inject GearLookup Lookup

<PageTitle>Partida · Punkartuchera</PageTitle>

<header class="page-header">
    <div class="page-header__title">
        <span class="page-kicker">A hostias por turnos</span>
        <h1 class="page-title distress">Partida</h1>
    </div>
</header>

@if (_error is not null)
{
    <p class="notice notice--danger" role="alert"><span>@_error</span></p>
}

@if (_loading)
{
    <p class="muted">Calentando motores…</p>
}
else if (Matches.Current is not { } match)
{
    @if (_bands.Count(b => !b.IsReadOnly) == 0)
    {
        <section class="punk-empty">
            <h2>Sin banda no hay bronca</h2>
            <p>Monta una banda antes de salir a pegarte.</p>
            <a class="btn btn--primary" href="bandas/nueva"><Icon Path="@Icons.Plus" /> Montar banda</a>
        </section>
    }
    else
    {
        <h2 class="section-title">Tu banda</h2>
        <div class="faction-grid">
            @foreach (var band in _bands.Where(b => !b.IsReadOnly))
            {
                <button type="button" class="faction-tile @(band.Id == _ownId ? "is-selected" : null)"
                        aria-pressed="@(band.Id == _ownId)" @onclick="() => SelectOwn(band.Id)">
                    @band.Name
                </button>
            }
        </div>

        @if (Matches.SupportsOnlineMatches)
        {
            <h2 class="section-title">Cada uno en su móvil</h2>
            <div class="paper match-setup">
                <p>Crea la partida y pásale el código al rival, o mete el que te haya dado él. Su banda te llega sola, sin balas ni fotos.</p>
                <div class="actions">
                    <button type="button" class="btn btn--blood" disabled="@(_busy || _ownId is null)" @onclick="CreateOnline">
                        <Icon Path="@Icons.Dice" /> Crear partida
                    </button>
                </div>
                <form class="match-join" @onsubmit="JoinOnline" @onsubmit:preventDefault>
                    <label class="field">
                        <span class="field__label">Código del rival</span>
                        <input class="field__input match-join__code" @bind="_code" @bind:event="oninput" maxlength="10" autocomplete="off"
                               autocapitalize="characters" spellcheck="false" placeholder="K7Q2XM" />
                    </label>
                    <button type="submit" class="btn btn--primary" disabled="@(_busy || _ownId is null || string.IsNullOrWhiteSpace(_code))">Entrar</button>
                </form>
            </div>
        }
        else
        {
            <p class="notice notice--warning">
                <span>Las partidas con código no están montadas en esta versión. Podéis jugar en un solo móvil.</span>
            </p>
        }

        <h2 class="section-title">En este móvil</h2>
        <div class="paper match-setup">
            <p>Las dos bandas en el mismo móvil. Vale cualquiera, también las rivales que hayas cargado.</p>
            <div class="faction-grid">
                @foreach (var band in _bands.Where(b => b.Id != _ownId))
                {
                    <button type="button" class="faction-tile @(band.Id == _rivalId ? "is-selected" : null)"
                            aria-pressed="@(band.Id == _rivalId)" @onclick="() => _rivalId = band.Id">
                        @band.Name
                    </button>
                }
            </div>
            <div class="actions">
                <button type="button" class="btn btn--primary" disabled="@(_busy || _ownId is null || _rivalId is null)" @onclick="StartLocal">
                    A pelear
                </button>
            </div>
        </div>
    }
}
else
{
    @if (match.IsOnline)
    {
        <div class="card match-code">
            <div class="match-code__value">
                <span class="datacard__label">Código de la partida</span>
                <span class="stamp stamp--light match-code__seed">@match.Code</span>
            </div>
            <span class="chip match-status match-status--@Matches.Connection.ToString().ToLowerInvariant()">@ConnectionText</span>
            @if (!match.HasRival)
            {
                <button type="button" class="btn btn--ghost" @onclick="() => ShareCode(match.Code!)">
                    <Icon Path="@Icons.Share" /> @(_copied ? "¡Copiado!" : "Pasar código")
                </button>
            }
            @if (Matches.Connection == RelayStatus.Offline && !match.ClosedByRival)
            {
                <button type="button" class="btn btn--ghost" disabled="@_busy" @onclick="Reconnect">Reconectar</button>
            }
        </div>
    }

    @if (match.ClosedByRival)
    {
        <p class="notice notice--danger">
            <span><strong>Se acabó.</strong> El rival ha cerrado la partida o ha caducado. Lo que veis es cómo quedó.</span>
        </p>
    }

    <section class="paper match-score" aria-label="Marcador">
        @ScoreView(MatchSide.Own, match.OwnBandName)
        <span class="match-score__vs" aria-hidden="true">vs</span>
        @ScoreView(MatchSide.Rival, match.RivalBandName ?? "Rival")
    </section>

    @if (match.Over)
    {
        <p class="notice match-result" role="status">
            <span><strong>Fin de la partida.</strong> @ResultText(match)</span>
        </p>
    }

    <div class="paper match-round">
        <Stepper Label="@($"Ronda (de {ActiveMatch.MaxRound})")" Value="match.Round" Min="1" Max="ActiveMatch.MaxRound" ValueChanged="SetRound" />
        @if (match.Round < ActiveMatch.MaxRound)
        {
            <button type="button" class="btn btn--blood" disabled="@(match.ClosedByRival || _busy)" @onclick="() => SetRound(match.Round + 1)">
                Siguiente ronda
            </button>
        }
        else if (!match.Over)
        {
            <button type="button" class="btn btn--blood" disabled="@(match.ClosedByRival || _busy)" @onclick="Finish">
                Cerrar la última ronda
            </button>
        }
        else
        {
            <button type="button" class="btn btn--ghost" disabled="@(match.ClosedByRival || _busy)" @onclick="() => SetRound(ActiveMatch.MaxRound)">
                Reabrir la ronda @ActiveMatch.MaxRound
            </button>
        }
    </div>

    <div class="match-sides">
        @MatchSideView((MatchSide.Own, match.OwnBandName, match.Own, true))
        @if (match.HasRival)
        {
            @MatchSideView((MatchSide.Rival, match.RivalBandName ?? "Rival", match.Rival, !match.IsOnline))
        }
        else
        {
            <section class="match-side">
                <h2 class="section-title">Rival</h2>
                <p class="paper match-waiting">
                    Esperando al rival… Que meta el código <strong>@match.Code</strong> en su Punkartuchera.
                </p>
            </section>
        }
    </div>

    @if (_sheet is { } open && SheetMember(open) is { } sheetMember)
    {
        var sheetBand = BandOf(open.Side);
        var sheetAids = AidsOf(open.Side);
        <MatchMemberSheet Member="Mini(sheetBand, sheetMember, open.Index)" Name="@sheetMember.Name" Role="@sheetMember.Role" Down="sheetMember.Down"
                          FactionId="@sheetBand?.FactionId" SubfactionId="@sheetBand?.SubfactionId"
                          Aids="sheetAids.Of(open.Index)" OnClose="() => _sheet = null">
            <AidTemplate Context="aid">
                @AidView((open.Side, sheetAids, aid, open.Index, true))
            </AidTemplate>
        </MatchMemberSheet>
    }

    @if (_rule is not null)
    {
        <RuleSheet Info="_rule" Title="@_ruleTitle" OnClose="() => _rule = null" />
    }

    <div class="actions match-end">
        <ConfirmButton Text="@(match.ClosedByRival ? "Cerrar" : "Terminar partida")" ConfirmText="Sí, terminar" OnConfirm="End" />
    </div>
}

@code {
    private IReadOnlyList<Band> _bands = [];
    private Dictionary<Guid, Band> _bandsById = [];
    private bool _loading = true;
    private bool _busy;
    private bool _copied;
    private string? _error;
    private string? _code;
    private Guid? _ownId;
    private Guid? _rivalId;
    private (MatchSide Side, int Index)? _sheet;
    private GearInfo? _rule;
    private string? _ruleTitle;
    private readonly Dictionary<MatchSide, (Band? Band, int Count, BandAids Aids)> _aidCache = [];

    private string ConnectionText => Matches.Connection switch
    {
        RelayStatus.Online => Matches.Current?.HasRival == true ? "En línea" : "Esperando",
        RelayStatus.Connecting => "Conectando…",
        RelayStatus.Reconnecting => "Reconectando…",
        _ => "Sin conexión",
    };

    protected override async Task OnInitializedAsync()
    {
        Matches.Changed += OnMatchChanged;
        try
        {
            await Matches.RestoreAsync();
        }
        catch (Exception ex) when (ex is MatchException or RelayException)
        {
            _error = ex.Message;
        }

        await LoadBandsAsync();
        _ownId = _bands.FirstOrDefault(b => !b.IsReadOnly)?.Id;
        _loading = false;
    }

    private RenderFragment MatchSideView((MatchSide Side, string Name, List<MatchMember> Members, bool Editable) side) => __builder =>
    {
        var band = BandOf(side.Side);
        var aids = AidsOf(side.Side);
        var editable = side.Editable && !Matches.Current!.ClosedByRival;
        <section class="match-side">
            <h2 class="section-title">@side.Name</h2>
            <p class="match-side__count">@side.Members.Count(m => !m.Down) en pie de @side.Members.Count</p>

            @if (aids.Band.Count > 0)
            {
                <div class="match-pool">
                    @foreach (var aid in aids.Band)
                    {
                        @AidView((side.Side, aids, aid, null, true))
                        @if (aid.PerStandingEachRound > 0 && editable && Counters(side.Side).GetValueOrDefault(MatchAid.RefillKey(aid.Key)) != Matches.Current!.Round)
                        {
                            var gain = aid.PerStandingEachRound * side.Members.Count(m => !m.Down);
                            <button type="button" class="btn btn--ghost match-pool__refill" disabled="@_busy" @onclick="() => Refill(side.Side, aid, gain)">
                                Empieza la ronda: +@gain
                            </button>
                        }
                    }
                </div>
            }

            <ul class="match-members">
                @for (var i = 0; i < side.Members.Count; i++)
                {
                    var index = i;
                    var member = side.Members[i];
                    var mini = Mini(band, member, index);
                    var memberAids = aids.Of(index);
                    <li class="match-member @(member.Down ? "is-down" : null) @(member.Activated ? "is-activated" : null)">
                        <button type="button" class="match-member__open" aria-label="Ver la ficha de @member.Name" @onclick="() => _sheet = (side.Side, index)">
                            <MiniPortrait Photo="mini?.Photo" Alt="@member.Name" Size="sm" />
                            <span class="match-member__name">
                                <strong>@member.Name</strong>
                                <small>@member.Role</small>
                            </span>
                        </button>
                        <button type="button" class="chip match-toggle" aria-pressed="@member.Activated"
                                disabled="@(!editable || member.Down)"
                                @onclick="() => Toggle(side.Side, index, activated: !member.Activated)">
                            @(member.Activated ? "Ya ha ido" : "Por actuar")
                        </button>
                        <button type="button" class="chip match-toggle match-toggle--down" aria-pressed="@member.Down"
                                disabled="@(!editable)"
                                @onclick="() => Toggle(side.Side, index, down: !member.Down)">
                            @(member.Down ? "Baja" : "En pie")
                        </button>
                        @if (memberAids.Count > 0)
                        {
                            <div class="match-aids match-member__aids">
                                @foreach (var aid in memberAids)
                                {
                                    @AidView((side.Side, aids, aid, index, false))
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        </section>
    };

    private RenderFragment AidView((MatchSide Side, BandAids Aids, MatchAid Aid, int? Index, bool Detailed) a) => __builder =>
    {
        var match = Matches.Current!;
        var counters = Counters(a.Side);
        var members = match.MembersOf(a.Side);
        var value = BandAids.ValueOf(counters, a.Aid, a.Index);
        var pool = a.Aid.Pool is { } poolKey && a.Aids.FindBand(poolKey) is { } poolAid ? BandAids.ValueOf(counters, poolAid) : (int?)null;
        var editable = (a.Side == MatchSide.Own || !match.IsOnline) && !match.ClosedByRival;
        var state = new AidState(value, match.Round, members.Count(m => m.Down), members.Count(m => !m.Down));
        <AidControl Aid="a.Aid" Value="value" State="state" Editable="editable" PoolLeft="pool" Detailed="a.Detailed"
                    OnChange="v => SetAid(a.Side, a.Aids, a.Aid, a.Index, v)" OnRule="r => OpenRule(r, BandOf(a.Side)?.FactionId)" />
    };

    private RenderFragment ScoreView(MatchSide side, string name) => __builder =>
    {
        var match = Matches.Current!;
        var score = match.ScoreOf(side);
        var editable = (side == MatchSide.Own || !match.IsOnline) && !match.ClosedByRival && (side == MatchSide.Own || match.HasRival);
        <div class="match-score__side">
            <span class="match-score__name">@name</span>
            <span class="match-score__value" aria-live="polite">@score</span>
            @if (editable)
            {
                <span class="match-score__controls">
                    <button type="button" class="stepper__btn" disabled="@(score <= 0)" aria-label="Quitar un punto a @name" @onclick="() => SetScore(side, score - 1)">−</button>
                    <button type="button" class="stepper__btn" aria-label="Sumar un punto a @name" @onclick="() => SetScore(side, score + 1)">+</button>
                </span>
            }
        </div>
    };

    private Band? Band(Guid? id) => id is { } value && _bandsById.TryGetValue(value, out var band) ? band : null;

    private Band? BandOf(MatchSide side) =>
        side == MatchSide.Own ? Band(Matches.Current?.OwnBandId) : Band(Matches.Current?.RivalBandId);

    private static Miniature? Mini(Band? band, MatchMember member, int index) =>
        member.MemberId is { } id ? band?.FindMember(id) : band?.Members.ElementAtOrDefault(index);

    private MatchMember? SheetMember((MatchSide Side, int Index) open) =>
        Matches.Current?.MembersOf(open.Side).ElementAtOrDefault(open.Index);

    private Dictionary<string, int> Counters(MatchSide side) => Matches.Current!.CountersOf(side);

    /// <summary>Ayudas de cada bando; se recalculan si cambia la banda o sus miembros.</summary>
    private BandAids AidsOf(MatchSide side)
    {
        var band = BandOf(side);
        var members = Matches.Current?.MembersOf(side) ?? [];
        var key = (band, members.Count);
        if (_aidCache.TryGetValue(side, out var cached) && ReferenceEquals(cached.Band, band) && cached.Count == members.Count)
        {
            return cached.Aids;
        }

        var aids = AidCatalog.For(band, members.Select(m => Mini(band, m, members.IndexOf(m))?.Role ?? m.Role).ToList());
        _aidCache[side] = (key.band, key.Count, aids);
        return aids;
    }

    private Task SetAid(MatchSide side, BandAids aids, MatchAid aid, int? index, int value)
    {
        var counters = Counters(side);
        var old = BandAids.ValueOf(counters, aid, index);
        var changes = new Dictionary<string, int> { [index is { } i ? MatchAid.MemberKey(aid.Key, i) : aid.Key] = value };

        // Dar una dosis la gasta de la reserva de la banda; quitarla la devuelve.
        if (aid.Pool is { } poolKey && aids.FindBand(poolKey) is { } pool)
        {
            changes[poolKey] = Math.Max(0, BandAids.ValueOf(counters, pool) - (value - old));
        }

        return RunAsync(() => Matches.SetCountersAsync(side, changes));
    }

    private Task Refill(MatchSide side, MatchAid aid, int gain) => RunAsync(() => Matches.SetCountersAsync(side, new Dictionary<string, int>
    {
        [aid.Key] = BandAids.ValueOf(Counters(side), aid) + gain,
        [MatchAid.RefillKey(aid.Key)] = Matches.Current!.Round,
    }));

    private Task SetScore(MatchSide side, int score) => RunAsync(() => Matches.SetScoreAsync(side, score));

    private Task Finish() => RunAsync(() => Matches.FinishAsync());

    private void OpenRule(string rule, string? factionId)
    {
        _rule = Lookup.Find(rule, factionId);
        _ruleTitle = rule;
    }

    private static string ResultText(ActiveMatch match)
    {
        var rival = match.RivalBandName ?? "el rival";
        return match.OwnScore == match.RivalScore
            ? $"Empate a {match.OwnScore}."
            : match.OwnScore > match.RivalScore
                ? $"Gana {match.OwnBandName}, {match.OwnScore} a {match.RivalScore}."
                : $"Gana {rival}, {match.RivalScore} a {match.OwnScore}.";
    }

    private void SelectOwn(Guid id)
    {
        _ownId = id;
        if (_rivalId == id)
        {
            _rivalId = null;
        }
    }

    private Task CreateOnline() => RunAsync(() => Matches.CreateOnlineAsync(_ownId!.Value));

    private Task JoinOnline() => RunAsync(() => Matches.JoinOnlineAsync(_code ?? string.Empty, _ownId!.Value));

    private Task StartLocal() => RunAsync(() => Matches.StartLocalAsync(_ownId!.Value, _rivalId!.Value));

    private Task Reconnect() => RunAsync(() => Matches.ReconnectAsync());

    private Task SetRound(int round) => RunAsync(() => Matches.SetRoundAsync(round));

    private Task Toggle(MatchSide side, int index, bool? activated = null, bool? down = null) => RunAsync(async () =>
    {
        var wasDown = Matches.Current!.MembersOf(side).ElementAtOrDefault(index)?.Down;
        await Matches.SetMemberAsync(side, index, activated, down);

        // Reglas que suman marcadores cuando cae alguien (Hasta el coño me tenéis).
        var aids = AidsOf(side);
        if (down is { } nowDown && wasDown is { } before && before != nowDown
            && aids.DownFeedOf(index) is { } feed && aids.FindBand(feed.Key) is { } target)
        {
            var value = BandAids.ValueOf(Counters(side), target) + (nowDown ? feed.Amount : -feed.Amount);
            await Matches.SetCountersAsync(side, new Dictionary<string, int> { [feed.Key] = Math.Max(0, value) });
        }
    });

    private Task End() => RunAsync(async () =>
    {
        await Matches.EndAsync();
        _sheet = null;
        _code = null;
        _rivalId = null;
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is MatchException or RelayException)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ShareCode(string code)
    {
        var text = $"Vente a una partida de Punkapocalyptic: entra en Punkartuchera › Partida y mete el código {code}";
        try
        {
            await JS.InvokeVoidAsync("navigator.share", new { title = "Partida de Punkapocalyptic", text });
            return;
        }
        catch (JSException)
        {
            // Sin menú de compartir (o cancelado): se copia el código.
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copied = true;
        }
        catch (JSException)
        {
        }
    }

    private async Task LoadBandsAsync()
    {
        _bands = await Bands.GetAllAsync();
        _bandsById = _bands.ToDictionary(b => b.Id);
        _aidCache.Clear();
    }

    private void OnMatchChanged() => _ = InvokeAsync(async () =>
    {
        // La banda del rival puede acabar de llegar: se recargan para tener sus fotos.
        if (Matches.Current?.RivalBandId is { } rivalId && !_bandsById.ContainsKey(rivalId))
        {
            await LoadBandsAsync();
        }

        StateHasChanged();
    });

    public void Dispose() => Matches.Changed -= OnMatchChanged;
}
