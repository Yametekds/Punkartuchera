@page "/mapa"
@using Punkartuchera.Core.Maps
@inject ITerrainCatalog Terrain
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Mapa · Punkartuchera</PageTitle>

<header class="page-header">
    <div class="page-header__title">
        <span class="page-kicker">Tierra de nadie</span>
        <h1 class="page-title distress">Generador de mapas</h1>
    </div>
</header>

<PageTabs Tabs="TabNames" @bind-Active="_tab" />

@if (_layout is not null)
{
    <div class="map-layout">
        <section class="map-panel @(_tab == TabMap ? "is-active" : null)" aria-label="Mapa generado">
            <div class="map-code card">
                <div class="map-code__value">
                    <span class="datacard__label">Código del mapa</span>
                    <span class="stamp stamp--light map-code__seed">@_layout.Code</span>
                </div>
                <button type="button" class="btn btn--ghost" @onclick="Share">
                    <Icon Path="@Icons.Copy" /> @(_shared ? "¡Pillado!" : "Pasar al rival")
                </button>
            </div>

            <div class="map-frame">
                <MapDiagram @key="_layout" Layout="_layout" />
            </div>

            @if (_layout.Leftovers.Count > 0)
            {
                <p class="notice notice--danger">
                    <span><strong>No cabe todo, tron.</strong> Se quedan fuera @LeftoversText. Quita algo o pilla una mesa más grande.</span>
                </p>
            }
            else if (_layout.MinGap < MapGenerator.DefaultMinGap || _layout.EdgeMargin < MapGenerator.DefaultMinGap)
            {
                <p class="notice notice--warning">
                    <span>
                        <strong>Va justito.</strong> El reglamento pide 10 cm entre piezas y con los bordes siempre que se pueda.
                        Con esta chatarra quedan @_layout.MinGap cm entre piezas y @_layout.EdgeMargin cm con los bordes.
                    </span>
                </p>
            }

            <dl class="map-balance">
                <div class="statbox"><dt>Lado B</dt><dd>@_layout.PiecesOn(MapSide.North)</dd></div>
                <div class="statbox statbox--ammo"><dt>Centro</dt><dd>@_layout.PiecesOn(MapSide.Center)</dd></div>
                <div class="statbox"><dt>Lado A</dt><dd>@_layout.PiecesOn(MapSide.South)</dd></div>
            </dl>
            <p class="muted map-balance__note">
                Cada pieza tiene su gemela girada en la otra mitad, del mismo material, así que las dos bandas ven lo mismo desde su despliegue.
                Lo impar va a la línea central, a la misma distancia de las dos.
            </p>

            @if (_layout.Pieces.Count > 0)
            {
                <h2 class="section-title">Materiales</h2>
                <ul class="map-legend">
                    @foreach (var material in _layout.Pieces.Select(p => p.Material).Distinct().OrderByDescending(m => m.Grade).ThenBy(m => m.Name))
                    {
                        <li>
                            <MaterialSwatch Material="material" />
                            <span>
                                @material.Name
                                <small class="map-legend__grade">@GradeText(material)</small>
                            </span>
                        </li>
                    }
                </ul>

                <h2 class="section-title">Piezas</h2>
                <ul class="map-legend map-legend--pieces">
                    @foreach (var group in _layout.Pieces.GroupBy(p => p.Type))
                    {
                        var first = group.First();
                        <li>
                            <strong>@group.Key.Abbreviation</strong>
                            <span>@group.Key.Name × @group.Count()</span>
                            @if (first.Mark.Length > 0)
                            {
                                <span class="stamp stamp--light map-legend__mark">@first.Mark</span>
                            }
                        </li>
                    }
                </ul>
                <p class="muted map-balance__note">
                    La marca es la del reglamento: el número es el tamaño de la pieza y la letra el grado de Cobertura (L ligera, M media, P pesada).
                </p>
            }
        </section>

        <section class="map-panel @(_tab == TabTerrain ? "is-active" : null)" aria-label="Elegir terreno">
            <h2 class="section-title">Mesa</h2>
            <div class="faction-grid">
                @foreach (var board in Terrain.Boards)
                {
                    <button type="button" class="faction-tile map-option @(board == _board ? "is-selected" : null)"
                            aria-pressed="@(board == _board)" @onclick="() => SelectBoard(board)">
                        <span>@board.Name</span>
                        <small>@board.Note · despliegue de @board.DeploymentDepth cm</small>
                    </button>
                }
            </div>

            <h2 class="section-title">Zonas de despliegue</h2>
            <div class="faction-grid">
                @foreach (var (orientation, name, hint) in Orientations)
                {
                    <button type="button" class="faction-tile map-option @(orientation == _orientation ? "is-selected" : null)"
                            aria-pressed="@(orientation == _orientation)" @onclick="() => SelectOrientation(orientation)">
                        <span class="map-option__head">
                            <svg class="map-option__icon" viewBox="0 0 12 12" aria-hidden="true">
                                <rect x=".5" y=".5" width="11" height="11" />
                                @if (orientation == DeploymentOrientation.Vertical)
                                {
                                    <rect class="map-option__zone" x=".5" y=".5" width="3" height="11" />
                                    <rect class="map-option__zone" x="8.5" y=".5" width="3" height="11" />
                                }
                                else
                                {
                                    <rect class="map-option__zone" x=".5" y=".5" width="11" height="3" />
                                    <rect class="map-option__zone" x=".5" y="8.5" width="11" height="3" />
                                }
                            </svg>
                            @name
                        </span>
                        <small>@hint</small>
                    </button>
                }
            </div>

            <h2 class="section-title">Chatarra para la mesa</h2>
            <div class="paper terrain-picker">
                @foreach (var type in Terrain.Types)
                {
                    var pick = _picks[type.Id];
                    var material = Terrain.FindMaterial(pick.MaterialId)!;
                    <div class="terrain-row">
                        <Stepper Label="@type.Name" Value="@pick.Count" Max="TerrainSelection.MaxPerType"
                                 ValueChanged="value => SetCount(type, value)" />
                        <div class="terrain-row__material">
                            <MaterialSwatch Material="material" />
                            <label class="visually-hidden" for="mat-@type.Id">Material de @type.Name</label>
                            <select id="mat-@type.Id" class="field__input terrain-row__select" value="@pick.MaterialId"
                                    @onchange="e => SetMaterial(type, e.Value as string)">
                                @foreach (var grade in Terrain.Materials.GroupBy(m => m.Grade))
                                {
                                    <optgroup label="@GradeGroupName(grade.Key)">
                                        @foreach (var option in grade)
                                        {
                                            <option value="@option.Id">@option.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <span class="terrain-row__grade">@GradeText(material)</span>
                        </div>
                        <p class="terrain-row__info">
                            @type.Width×@type.Depth cm · @SizeText(type)@(type.Description is null ? null : $" · {type.Description}")
                        </p>
                    </div>
                }
                <p class="terrain-picker__total">@TotalPieces piezas en total</p>
                <p class="terrain-picker__rule">
                    El reglamento pide para @_board.Name:
                    @for (var size = 3; size >= 1; size--)
                    {
                        var wanted = _board.ElementsBySize[size - 1];
                        var have = _bySize[size];
                        <span class="terrain-picker__size @(have == wanted ? "is-ok" : null)">
                            @wanted de tamaño @size<small> (llevas @have)</small>
                        </span>
                    }
                </p>
            </div>

            <div class="actions">
                <button type="button" class="btn btn--ghost" @onclick="ResetCounts">Lo del reglamento</button>
                <button type="button" class="btn btn--ghost" @onclick="ClearCounts">Mesa pelada</button>
            </div>

            <h2 class="section-title">¿Te han pasado un código?</h2>
            <form class="map-seed-form" @onsubmit="ApplyCode">
                <label class="visually-hidden" for="map-code">Código del mapa</label>
                <input id="map-code" class="field__input" @bind="_codeInput" placeholder="Ej. K7Q2XM" autocomplete="off" maxlength="12" />
                <button type="submit" class="btn btn--primary">Cargar</button>
            </form>
            <p class="muted">Mismo código, misma chatarra y mismo despliegue, mismo mapa. Si te pasan el enlace, ya viene todo puesto.</p>
        </section>
    </div>
}

<button type="button" class="btn btn--blood fab" @onclick="Reroll"><Icon Path="@Icons.Dice" /> Otro mapa</button>

@code {
    private const string TabMap = "Mapa";
    private const string TabTerrain = "Terreno";
    private static readonly string[] TabNames = [TabMap, TabTerrain];

    [SupplyParameterFromQuery(Name = "codigo")] public string? CodeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "mesa")] public string? BoardQuery { get; set; }

    [SupplyParameterFromQuery(Name = "terreno")] public string? TerrainQuery { get; set; }

    [SupplyParameterFromQuery(Name = "despliegue")] public string? OrientationQuery { get; set; }

    private static readonly (DeploymentOrientation, string, string)[] Orientations =
    [
        (DeploymentOrientation.Horizontal, "Horizontal", "Arriba y abajo"),
        (DeploymentOrientation.Vertical, "Vertical", "A izquierda y derecha"),
    ];

    private string _tab = TabMap;
    private BoardPreset _board = default!;
    private DeploymentOrientation _orientation;
    private Dictionary<string, TerrainPick> _picks = [];
    private int[] _bySize = new int[4];
    private MapLayout? _layout;
    private string? _codeInput;
    private bool _shared;

    private int TotalPieces => _picks.Values.Sum(p => p.Count);

    private string LeftoversText => string.Join(", ", _layout!.Leftovers
        .GroupBy(t => t.Name)
        .Select(g => $"{g.Count()}× {g.Key}"));

    /// <summary>El enlace es el estado de la pantalla: compartirlo o recargar da el mismo mapa.</summary>
    protected override void OnParametersSet()
    {
        var code = MapSeed.Normalize(CodeQuery);
        var board = Terrain.FindBoard(BoardQuery);
        if (code is null || TerrainQuery is null || board is null)
        {
            board ??= Terrain.DefaultBoard;
            Go(code ?? MapSeed.NewCode(),
               board,
               TerrainSelection.ParseOrientation(OrientationQuery),
               TerrainQuery is null ? TerrainSelection.Defaults(Terrain, board) : TerrainSelection.Parse(TerrainQuery, Terrain));
            return;
        }

        _board = board;
        _orientation = TerrainSelection.ParseOrientation(OrientationQuery);
        _picks = TerrainSelection.Parse(TerrainQuery, Terrain);
        _bySize = TerrainSelection.CountBySize(_picks, Terrain);
        _layout = MapGenerator.Generate(_board, TerrainSelection.ToCounts(_picks, Terrain), code, _orientation);
        _shared = false;
    }

    private void Go(string code, BoardPreset board, DeploymentOrientation orientation, IReadOnlyDictionary<string, TerrainPick> picks)
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["codigo"] = code,
            ["mesa"] = board.Id,
            ["despliegue"] = TerrainSelection.FormatOrientation(orientation),
            ["terreno"] = TerrainSelection.Format(picks, Terrain),
        });
        Navigation.NavigateTo(uri, replace: true);
    }

    private void Go(IReadOnlyDictionary<string, TerrainPick> picks) => Go(_layout!.Code, _board, _orientation, picks);

    private void Reroll()
    {
        _tab = TabMap;
        Go(MapSeed.NewCode(), _board, _orientation, _picks);
    }

    /// <summary>Si la chatarra era la del reglamento para la mesa anterior, pasa a la de la nueva.</summary>
    private void SelectBoard(BoardPreset board)
    {
        var wasDefault = Terrain.Types.All(t => _picks[t.Id].Count == Terrain.DefaultCounts(_board).GetValueOrDefault(t.Id));
        var picks = wasDefault ? WithCounts(Terrain.DefaultCounts(board)) : _picks;
        Go(_layout!.Code, board, _orientation, picks);
    }

    private void SelectOrientation(DeploymentOrientation orientation) => Go(_layout!.Code, _board, orientation, _picks);

    private void SetCount(TerrainType type, int value) =>
        Go(new Dictionary<string, TerrainPick>(_picks) { [type.Id] = _picks[type.Id] with { Count = value } });

    private void SetMaterial(TerrainType type, string? materialId)
    {
        if (Terrain.FindMaterial(materialId) is { } material)
        {
            Go(new Dictionary<string, TerrainPick>(_picks) { [type.Id] = _picks[type.Id] with { MaterialId = material.Id } });
        }
    }

    /// <summary>Cambia las cantidades y deja los materiales que hubiera elegido el jugador.</summary>
    private Dictionary<string, TerrainPick> WithCounts(IReadOnlyDictionary<string, int> counts) =>
        _picks.ToDictionary(p => p.Key, p => p.Value with { Count = counts.GetValueOrDefault(p.Key) });

    private void ResetCounts() => Go(WithCounts(Terrain.DefaultCounts(_board)));

    private void ClearCounts() => Go(WithCounts(new Dictionary<string, int>()));

    private void ApplyCode()
    {
        var code = MapSeed.Normalize(_codeInput);
        if (code is null)
        {
            return;
        }

        _codeInput = null;
        _tab = TabMap;
        Go(code, _board, _orientation, _picks);
    }

    private async Task Share()
    {
        var text = $"Mapa {_layout!.Code} para Punkapocalyptic";
        try
        {
            await JS.InvokeVoidAsync("navigator.share", new { title = text, url = Navigation.Uri });
            return;
        }
        catch (JSException)
        {
            // Sin menú de compartir (o cancelado): se copia el enlace.
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.Uri);
            _shared = true;
        }
        catch (JSException)
        {
        }
    }

    private static string GradeText(TerrainMaterial material) =>
        material.Grade == CoverGrade.None ? "Sin Cobertura" : $"{material.GradeName} {material.ArmourText}";

    private static string GradeGroupName(CoverGrade grade) => grade switch
    {
        CoverGrade.Light => "Cobertura ligera (+3)",
        CoverGrade.Medium => "Cobertura media (+5)",
        CoverGrade.Heavy => "Cobertura pesada (+7)",
        _ => "Sin Cobertura",
    };

    /// <summary>A quién tapa cada tamaño cuando la Cobertura es total (reglas, p. 17).</summary>
    private static string SizeText(TerrainType type) => type.Size switch
    {
        0 => "a ras de suelo",
        1 => "tamaño 1: protege a peanas de 25 y 40 mm",
        2 => "tamaño 2: oculta peanas de 25 y 40 mm",
        _ => "tamaño 3: oculta a cualquiera",
    };
}
