@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="punk-shell">
    <header class="punk-topbar">
        <span class="punk-topbar__rust" aria-hidden="true"></span>
        <button type="button" class="appbar-menu" aria-label="Abrir menú" aria-expanded="@_drawerOpen" @onclick="() => _drawerOpen = true">
            <Icon Path="@Icons.Menu" />
        </button>
        <a class="punk-brand" href="">
            <span class="punk-brand__name">Punkartuchera</span>
        </a>
        @* En pantallas anchas el menú va en la propia chapa y el lateral se queda para el móvil *@
        <nav class="topnav" aria-label="Secciones">
            @foreach (var item in AppNavigation.Items.Where(i => i.Available))
            {
                <a class="topnav__item @(IsActive(item) ? "active" : null)" href="@item.Href" aria-current="@(IsActive(item) ? "page" : null)">
                    <Icon Path="@item.Icon" />
                    <span>@item.Label</span>
                </a>
            }
        </nav>
        <Icon Path="@Icons.Skull" Class="punk-brand__mark" />
    </header>

    @if (_drawerOpen)
    {
        <div class="drawer-scrim" @onclick="() => _drawerOpen = false"></div>
    }
    <nav class="drawer @(_drawerOpen ? "is-open" : null)" aria-label="Secciones" inert="@(!_drawerOpen)">
        <div class="drawer__head">
            <span class="drawer__title">Punkartuchera</span>
            <button type="button" class="btn btn--icon" aria-label="Cerrar menú" @onclick="() => _drawerOpen = false">
                <Icon Path="@Icons.Close" />
            </button>
        </div>
        <span class="drawer__scribble scribble">¿Adónde vas, chorbo?</span>
        <ul class="drawer__list">
            @foreach (var item in AppNavigation.Items)
            {
                <li>
                    @if (item.Available)
                    {
                        <NavLink class="drawer__item" href="@item.Href" Match="@(item.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                            <Icon Path="@item.Icon" />
                            <span>@item.Label</span>
                        </NavLink>
                    }
                    else
                    {
                        <span class="drawer__item drawer__item--soon">
                            <Icon Path="@item.Icon" />
                            <span>@item.Label</span>
                            <small class="scribble">pronto</small>
                        </span>
                    }
                </li>
            }
        </ul>
    </nav>

    <main class="punk-main">
        @Body
    </main>

    @* En móvil y tablet, las secciones de siempre a mano del pulgar (las demás siguen en el menú) *@
    <nav class="tabbar" aria-label="Accesos rápidos">
        <span class="tabbar__lip" aria-hidden="true"></span>
        @foreach (var item in AppNavigation.Items.Where(i => i.Available).Take(4))
        {
            <a class="tabbar__item @(IsActive(item) ? "active" : null)" href="@item.Href" aria-current="@(IsActive(item) ? "page" : null)">
                <Icon Path="@item.Icon" />
                <span>@item.Label</span>
            </a>
        }
    </nav>

    <StampToast />
</div>

@code {
    private bool _drawerOpen;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _drawerOpen = false;
        StateHasChanged();
    }

    // "Bandas" sigue marcada dentro de una banda o una ficha (bandas/...), no solo en la portada.
    private bool IsActive(AppNavigation.NavItem item)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return item.Href.Length == 0
            ? path.Length == 0 || path == "bandas" || path.StartsWith("bandas/", StringComparison.Ordinal)
            : path == item.Href || path.StartsWith(item.Href + "/", StringComparison.Ordinal);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
