@inject IRulesCatalog Rules
@inject GearLookup Lookup
@inject UnitRules UnitRules
@inject CloseCombat CloseCombat

@* Ficha de miembro estilo datacard: cabecera de chapa con atributos y cuerpo de papel. *@
<article class="datacard">
    <header class="datacard__head">
        <MiniPortrait Photo="Member.Photo" Alt="@Member.Name" Size="md" />
        <div class="datacard__title">
            @if (Href is null)
            {
                <h3 class="datacard__name">@Member.Name</h3>
            }
            else
            {
                <h3 class="datacard__name"><a href="@Href">@Member.Name</a></h3>
            }
            @if (!string.IsNullOrEmpty(Member.Role))
            {
                <span class="datacard__role">@Member.Role</span>
            }
        </div>
        <dl class="datacard__stats" style="--stat-count: @(Rules.Stats.Count + 1)">
            @foreach (var stat in Rules.Stats)
            {
                <div class="statbox" title="@stat.Name">
                    <dt>@stat.Abbreviation</dt>
                    <dd>@Member.GetStat(stat.Key, stat.Default)</dd>
                </div>
            }
            <div class="statbox statbox--ammo" title="@(HideAmmo ? "Las balas del rival son secreto" : "Balas")">
                <dt>Balas</dt>
                <dd>@(HideAmmo ? "?" : Member.Ammo)</dd>
            </div>
        </dl>
    </header>

    <div class="datacard__body">
        @if (Member.Gear.Count > 0)
        {
            <ul class="gear-list">
                @foreach (var gear in Member.Gear)
                {
                    var info = Lookup.Find(gear.Name, FactionId);
                    <li class="gear-item">
                        <div class="gear-item__head">
                            <span class="gear-item__name">@gear.Name</span>
                            @if (info is not null)
                            {
                                <span class="gear-item__kind">@RuleSheet.KindLabel(info.Kind)</span>
                            }
                        </div>
                        @if (info is not null)
                        {
                            <p class="gear-item__data">
                                <RuleProse Text="@info.Summary" Class="" Inline="true" Explain="@(info.Kind is not (GearInfoKind.MeleeWeapon or GearInfoKind.RangedWeapon or GearInfoKind.Armor))" />
                                <button type="button" class="gear-item__link" aria-label="Qué dice el reglamento de @gear.Name" @onclick="() => Open(info, gear.Name)">regla</button>
                            </p>
                        }
                        else
                        {
                            <p class="gear-item__data gear-item__data--missing">No está en el reglamento.</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(gear.Notes))
                        {
                            <p class="gear-item__notes">@gear.Notes</p>
                        }
                    </li>
                }
            </ul>
        }

        @if (_melee.Count > 0)
        {
            <div class="melee-fallback">
                <span class="datacard__label">En cuerpo a cuerpo</span>
                <ul class="melee-fallback__list">
                    @foreach (var fallback in _melee)
                    {
                        <li class="melee-fallback__item melee-fallback__item--@fallback.Reason.ToString().ToLowerInvariant()">
                            <span class="melee-fallback__name">
                                @if (fallback.From is not null)
                                {
                                    @fallback.From<span class="melee-fallback__as"> como </span>
                                }
                                @fallback.Profile.Name.ToLowerInvariant()
                            </span>
                            <span class="melee-fallback__profile">C @(fallback.Profile.Combat ?? "+0") · F @fallback.Profile.Strength · Pen @fallback.Profile.Penetration</span>
                            <small class="melee-fallback__why">@fallback.Explanation</small>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (Member.Skills.Count > 0)
        {
            <div class="datacard__skills">
                <span class="datacard__label">Habilidades</span>
                <ul class="tags">
                    @foreach (var skill in Member.Skills)
                    {
                        var rule = Lookup.Find(skill, FactionId);
                        <li>
                            @if (rule is null)
                            {
                                <span class="tag tag--skill">@skill</span>
                            }
                            else
                            {
                                <button type="button" class="tag tag--skill tag--button" aria-label="Qué dice el reglamento de @skill" @onclick="() => Open(rule, skill)">@skill</button>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        @if (_rules.Count > 0)
        {
            <details class="unit-rules">
                <summary class="unit-rules__summary">
                    <span class="datacard__label">Reglas especiales</span>
                    <span class="unit-rules__count">@_rules.Count</span>
                </summary>
                <dl class="unit-rules__list">
                    @foreach (var rule in _rules)
                    {
                        <div class="unit-rules__item">
                            <dt class="unit-rules__name">
                                @rule.Name
                                @if (rule.From is not null)
                                {
                                    <small class="unit-rules__from">@rule.From</small>
                                }
                                else if (rule.Origin == UnitRuleOrigin.Skill)
                                {
                                    <small class="unit-rules__from">habilidad</small>
                                }
                            </dt>
                            <dd>
                                <RuleProse Text="@rule.Text" Except="@rule.Name" Explain="false" />
                                @if (rule.Table is not null)
                                {
                                    <RuleTableView Table="rule.Table" />
                                }
                            </dd>
                        </div>
                    }
                </dl>
            </details>
        }

        @if (!string.IsNullOrWhiteSpace(Member.Notes))
        {
            <p class="datacard__notes">@Member.Notes</p>
        }

        @if (Member.Gear.Count == 0 && Member.Skills.Count == 0 && string.IsNullOrWhiteSpace(Member.Notes))
        {
            <p class="datacard__empty scribble">Ni equipo ni habilidades. Va a pelo.</p>
        }

        @if (Href is not null)
        {
            <a class="datacard__edit" href="@Href"><Icon Path="@Icons.Edit" /> Editar ficha</a>
        }
    </div>
</article>

@if (_open is not null)
{
    <RuleSheet Info="_open" Title="@_openTitle" OnClose="() => _open = null" />
}

@code {
    [Parameter, EditorRequired] public Miniature Member { get; set; } = default!;

    /// <summary>Destino para editar la ficha; nulo si no es editable.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Oculta las balas (fichas del rival).</summary>
    [Parameter] public bool HideAmmo { get; set; }

    /// <summary>Facción de la banda, para elegir bien el equipo cuando dos facciones usan el mismo nombre.</summary>
    [Parameter] public string? FactionId { get; set; }

    /// <summary>Subfacción de la banda, para encontrar sus tropas y reglas.</summary>
    [Parameter] public string? SubfactionId { get; set; }

    private IReadOnlyList<UnitRule> _rules = [];
    private IReadOnlyList<MeleeFallback> _melee = [];

    protected override void OnParametersSet()
    {
        _rules = UnitRules.For(Member, FactionId, SubfactionId);
        _melee = CloseCombat.For(Member, FactionId);
    }

    private GearInfo? _open;
    private string? _openTitle;

    private void Open(GearInfo info, string title)
    {
        _open = info;
        _openTitle = title;
    }
}
