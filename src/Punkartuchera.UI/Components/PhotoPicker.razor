@using Punkartuchera.Core.Storage
@inject IPhotoStore Photos
@inject PhotoUrlProvider PhotoUrls

<div class="photo-picker">
    <div class="photo-picker__actions">
        <label class="btn btn--ghost">
            <Icon Path="@Icons.Camera" /> Cámara
            <InputFile class="visually-hidden" accept="image/*" capture="environment" OnChange="OnFileSelected" />
        </label>
        <label class="btn btn--ghost">
            <Icon Path="@Icons.Image" /> Galería
            <InputFile class="visually-hidden" accept="image/*" OnChange="OnFileSelected" />
        </label>
        <button type="button" class="btn btn--ghost" @onclick="() => _showStock = !_showStock">
            <Icon Path="@Icons.Skull" /> Retratos
        </button>
        @if (Value is not null)
        {
            <button type="button" class="btn btn--ghost btn--danger-text" @onclick="() => SetAsync(null)">Quitar</button>
        }
    </div>

    @if (_busy)
    {
        <p class="muted">Procesando foto…</p>
    }

    @if (_error is not null)
    {
        <p class="notice notice--danger">@_error</p>
    }

    @if (_showStock)
    {
        <div class="stock-grid">
            @foreach (var image in StockImages.All)
            {
                <button type="button" class="stock-grid__item @(Value?.Key == image.Key ? "is-selected" : null)"
                        @onclick="() => PickStock(image.Key)">
                    <img src="@StockImages.Url(image.Key)" alt="@image.Label" />
                    <span>@image.Label</span>
                </button>
            }
        </div>
    }
</div>

@code {
    // Las fotos se reducen en el navegador antes de guardarlas.
    private const int MaxSidePixels = 640;
    private const long MaxUploadBytes = 15 * 1024 * 1024;
    private const long MaxOriginalBytes = 3 * 1024 * 1024;

    [Parameter] public PhotoRef? Value { get; set; }

    [Parameter] public EventCallback<PhotoRef?> ValueChanged { get; set; }

    /// <summary>Se invoca con la clave de cada foto nueva guardada, para poder limpiarla si se cancela.</summary>
    [Parameter] public EventCallback<string> OnPhotoStored { get; set; }

    private bool _busy;
    private bool _showStock;
    private string? _error;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        _busy = true;
        var file = e.File;
        try
        {
            var (data, contentType) = await ReadPhotoAsync(file);
            var key = await Photos.SaveAsync(data, contentType);
            PhotoUrls.Remember(key, new StoredPhoto(key, contentType, data).ToDataUrl());
            await OnPhotoStored.InvokeAsync(key);
            await SetAsync(PhotoRef.Stored(key));
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Foto no válida ({file.ContentType}, {file.Size} bytes): {ex}");
            _error = IsHeic(file)
                ? "Esa foto está en formato HEIC y el navegador no la entiende. Hazle una captura o pásala a JPG."
                : $"No se pudo leer la imagen ({DescribeFile(file)}). Prueba con otra foto.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Reduce la foto en el navegador. Si el móvil no puede (fotos enormes de 50-100 MP
    /// agotan la memoria del lienzo), guarda el archivo original cuando es pequeño.
    /// </summary>
    private static async Task<(byte[] Data, string ContentType)> ReadPhotoAsync(IBrowserFile file)
    {
        try
        {
            var resized = await file.RequestImageFileAsync("image/jpeg", MaxSidePixels, MaxSidePixels);
            var data = await ReadAllAsync(resized, MaxUploadBytes);
            if (data.Length > 0)
            {
                return (data, "image/jpeg");
            }
        }
        catch (Exception ex) when (file.Size <= MaxOriginalBytes && IsWebImage(file))
        {
            Console.Error.WriteLine($"No se pudo reducir la foto, se guarda la original: {ex.Message}");
        }

        if (file.Size > MaxOriginalBytes || !IsWebImage(file))
        {
            throw new InvalidOperationException("La foto no se puede reducir y es demasiado grande para guardarla tal cual.");
        }

        return (await ReadAllAsync(file, MaxOriginalBytes), file.ContentType);
    }

    private static async Task<byte[]> ReadAllAsync(IBrowserFile file, long maxBytes)
    {
        await using var stream = file.OpenReadStream(maxBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        return buffer.ToArray();
    }

    private static bool IsWebImage(IBrowserFile file) =>
        file.ContentType is "image/jpeg" or "image/png" or "image/webp" or "image/gif";

    private static bool IsHeic(IBrowserFile file) =>
        file.ContentType is "image/heic" or "image/heif"
        || file.Name.EndsWith(".heic", StringComparison.OrdinalIgnoreCase)
        || file.Name.EndsWith(".heif", StringComparison.OrdinalIgnoreCase);

    private static string DescribeFile(IBrowserFile file)
    {
        var type = string.IsNullOrEmpty(file.ContentType) ? "tipo desconocido" : file.ContentType;
        return $"{type}, {file.Size / 1024d / 1024d:0.#} MB";
    }

    private async Task PickStock(string key)
    {
        _showStock = false;
        await SetAsync(PhotoRef.Stock(key));
    }

    private Task SetAsync(PhotoRef? photo)
    {
        Value = photo;
        return ValueChanged.InvokeAsync(photo);
    }
}
