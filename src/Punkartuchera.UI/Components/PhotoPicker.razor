@using Punkartuchera.Core.Storage
@implements IAsyncDisposable
@inject IPhotoStore Photos
@inject PhotoUrlProvider PhotoUrls
@inject PhotoCropper Cropper

<div class="photo-picker">
    <div class="photo-picker__actions">
        <label class="btn btn--ghost">
            <Icon Path="@Icons.Camera" /> Cámara
            <input type="file" class="visually-hidden" accept="image/*" capture="environment" @ref="_cameraInput" @onchange="() => OpenAsync(_cameraInput)" />
        </label>
        <label class="btn btn--ghost">
            <Icon Path="@Icons.Image" /> Galería
            <input type="file" class="visually-hidden" accept="image/*" @ref="_galleryInput" @onchange="() => OpenAsync(_galleryInput)" />
        </label>
        <button type="button" class="btn btn--ghost" @onclick="() => _showStock = !_showStock">
            <Icon Path="@Icons.Skull" /> Retratos
        </button>
        @if (Value is not null)
        {
            <button type="button" class="btn btn--ghost btn--danger-text" @onclick="() => SetAsync(null)">Quitar</button>
        }
    </div>

    @if (_busy && !_cropping)
    {
        <p class="muted">Cargando foto…</p>
    }

    @if (_error is not null)
    {
        <p class="notice notice--danger">@_error</p>
    }

    @if (_showStock)
    {
        <div class="stock-grid">
            @foreach (var image in StockImages.All)
            {
                <button type="button" class="stock-grid__item @(Value?.Key == image.Key ? "is-selected" : null)"
                        @onclick="() => PickStock(image.Key)">
                    <img src="@StockImages.Url(image.Key)" alt="@image.Label" />
                    <span>@image.Label</span>
                </button>
            }
        </div>
    }
</div>

@if (_cropping)
{
    <div class="cropper" role="dialog" aria-modal="true" aria-labelledby="cropper-title">
        <div class="cropper__panel">
            <h2 id="cropper-title" class="section-title">Encuadra la jeta</h2>
            <p class="muted cropper__hint">Arrastra para mover y pellizca o usa la barra para acercar.</p>
            <div class="cropper__stage">
                <canvas class="cropper__canvas" @ref="_canvas"></canvas>
            </div>
            <label class="cropper__zoom">
                <span class="visually-hidden">Zoom</span>
                <Icon Path="@Icons.Image" Class="cropper__zoom-icon cropper__zoom-icon--small" />
                <input type="range" @ref="_zoom" min="1" max="6" step="0.01" value="1" />
                <Icon Path="@Icons.Image" Class="cropper__zoom-icon" />
            </label>
            <div class="cropper__actions">
                <button type="button" class="btn btn--ghost" disabled="@_busy" @onclick="CancelCropAsync">Cancelar</button>
                <button type="button" class="btn btn--primary" disabled="@_busy" @onclick="ConfirmCropAsync">
                    @(_busy ? "Guardando…" : "Usar foto")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public PhotoRef? Value { get; set; }

    [Parameter] public EventCallback<PhotoRef?> ValueChanged { get; set; }

    /// <summary>Se invoca con la clave de cada foto nueva guardada, para poder limpiarla si se cancela.</summary>
    [Parameter] public EventCallback<string> OnPhotoStored { get; set; }

    private ElementReference _cameraInput;
    private ElementReference _galleryInput;
    private ElementReference _canvas;
    private ElementReference _zoom;
    private bool _busy;
    private bool _cropping;
    private bool _attachPending;
    private bool _showStock;
    private string? _error;

    private async Task OpenAsync(ElementReference input)
    {
        _error = null;
        _busy = true;
        try
        {
            var result = await Cropper.LoadAsync(input);
            if (result.IsOk)
            {
                _showStock = false;
                _cropping = true;
                _attachPending = true;
            }
            else if (!result.IsEmpty)
            {
                _error = result.IsHeic
                    ? "Esa foto está en formato HEIC y el navegador no la entiende. Hazle una captura o pásala a JPG."
                    : "El navegador no puede abrir esa imagen. Prueba con otra foto o hazle una captura.";
            }
        }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"No se pudo abrir la foto: {ex.Message}");
            _error = "No se pudo abrir la foto. Prueba otra vez.";
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_attachPending && _cropping)
        {
            _attachPending = false;
            await Cropper.AttachAsync(_canvas, _zoom);
        }
    }

    private async Task ConfirmCropAsync()
    {
        _busy = true;
        try
        {
            var data = await Cropper.ExportJpegAsync();
            var key = await Photos.SaveAsync(data, "image/jpeg");
            PhotoUrls.Remember(key, new StoredPhoto(key, "image/jpeg", data).ToDataUrl());
            await OnPhotoStored.InvokeAsync(key);
            await SetAsync(PhotoRef.Stored(key));
            _cropping = false;
        }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"No se pudo guardar la foto: {ex.Message}");
            _error = "No se pudo guardar la foto. Prueba otra vez.";
            _cropping = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelCropAsync()
    {
        _cropping = false;
        await Cropper.CancelAsync();
    }

    private async Task PickStock(string key)
    {
        _showStock = false;
        await SetAsync(PhotoRef.Stock(key));
    }

    private Task SetAsync(PhotoRef? photo)
    {
        Value = photo;
        return ValueChanged.InvokeAsync(photo);
    }

    public async ValueTask DisposeAsync()
    {
        if (_cropping)
        {
            try
            {
                await Cropper.CancelAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
