@using QRCoder

@* Dibuja un QR como SVG, sin imágenes ni librerías en el navegador. *@
<svg class="qr-code @Class" viewBox="@($"0 0 {_size} {_size}")" role="img" aria-label="@Label" shape-rendering="crispEdges">
    <rect width="100%" height="100%" class="qr-code__bg" />
    <path d="@_path" class="qr-code__modules" />
</svg>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    [Parameter] public string Label { get; set; } = "Código QR";

    [Parameter] public string? Class { get; set; }

    private string? _rendered;
    private string _path = string.Empty;
    private int _size;

    protected override void OnParametersSet()
    {
        if (Text == _rendered)
        {
            return;
        }

        _rendered = Text;
        using var generator = new QRCodeGenerator();
        // Corrección media: aguanta reflejos en la pantalla. Las bandas muy grandes bajan a la mínima para caber.
        var level = Text.Length > 1200 ? QRCodeGenerator.ECCLevel.L : QRCodeGenerator.ECCLevel.M;
        using var data = generator.CreateQrCode(Text, level);

        // La matriz ya incluye el margen de cuatro módulos que necesita el lector.
        var matrix = data.ModuleMatrix;
        _size = matrix.Count;
        var path = new System.Text.StringBuilder();
        for (var y = 0; y < matrix.Count; y++)
        {
            var row = matrix[y];
            var x = 0;
            while (x < row.Length)
            {
                if (!row[x])
                {
                    x++;
                    continue;
                }

                var start = x;
                while (x < row.Length && row[x])
                {
                    x++;
                }

                path.Append('M').Append(start).Append(' ').Append(y).Append('h').Append(x - start).Append("v1h").Append(start - x).Append('z');
            }
        }

        _path = path.ToString();
    }
}
