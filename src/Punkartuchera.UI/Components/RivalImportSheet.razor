@implements IAsyncDisposable
@inject BandExchangeService Exchange
@inject IJSRuntime JS
@inject NavigationManager Navigation

@* Hoja para cargar la banda del rival: escanea su QR o abre su archivo. *@
<div class="sheet-scrim" @onclick="Close"></div>
<section class="sheet paper" role="dialog" aria-modal="true" aria-labelledby="import-title">
    <header class="sheet__head">
        <h2 id="import-title" class="sheet__title">Cargar rival</h2>
        <button type="button" class="btn btn--icon sheet__close" aria-label="Cerrar" @onclick="Close"><Icon Path="@Icons.Close" /></button>
    </header>

    <p>Apunta al QR de su banda. Llega sin fotos.</p>
    <div class="scanner @(_cameraState == "ok" ? "is-live" : null)">
        <video @ref="_video" class="scanner__video" playsinline muted></video>
        @if (_cameraState == "ok")
        {
            <span class="scanner__frame" aria-hidden="true"></span>
        }
        else
        {
            <p class="scanner__msg">@CameraMessage</p>
        }
    </div>

    @if (_busy)
    {
        <p class="muted" role="status">Cacheando a la banda rival…</p>
    }

    @if (_error is not null)
    {
        <p class="notice notice--danger" role="alert">@_error</p>
    }

    <p>¿Te ha mandado el archivo? Así la ves entera, con fotos.</p>
    <div class="actions">
        <label class="btn btn--ghost">
            <Icon Path="@Icons.Inbox" /> Abrir archivo
            <InputFile class="visually-hidden" OnChange="ImportFile" />
        </label>
    </div>
</section>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _video;
    private IJSObjectReference? _module;
    private DotNetObjectReference<RivalImportSheet>? _self;
    private string _cameraState = "starting";
    private bool _busy;
    private string? _error;

    private string CameraMessage => _cameraState switch
    {
        "denied" => "Sin permiso para la cámara. Dáselo en el navegador o tira del archivo.",
        "nocamera" => "Aquí no hay cámara a la vista. Tira del archivo.",
        "error" => "La cámara no arranca. Tira del archivo.",
        _ => "Encendiendo la cámara…",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Punkartuchera.UI/js/punkQr.js");
            _self = DotNetObjectReference.Create(this);
            _cameraState = await _module.InvokeAsync<string>("start", _video, _self);
        }
        catch (JSException)
        {
            _cameraState = "error";
        }

        StateHasChanged();
    }

    /// <summary>Lo llama el lector con cada QR que ve; devuelve si hay que seguir escaneando.</summary>
    [JSInvokable]
    public async Task<bool> OnCode(string text)
    {
        if (_busy)
        {
            return true;
        }

        if (!BandQrCodec.LooksLikeBand(text))
        {
            _error = "Ese QR no es una banda de Punkartuchera.";
            StateHasChanged();
            return true;
        }

        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            var band = await Exchange.ImportQrAsync(text);
            Navigation.NavigateTo($"bandas/{band.Id}");
            return false;
        }
        catch (BandExchangeException ex)
        {
            _error = ex.Message;
            return true;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ImportFile(InputFileChangeEventArgs e)
    {
        _error = null;
        _busy = true;
        try
        {
            await using var stream = e.File.OpenReadStream(BandExchangeService.MaxFileBytes);
            var band = await Exchange.ImportAsync(stream);
            Navigation.NavigateTo($"bandas/{band.Id}");
        }
        catch (BandExchangeException ex)
        {
            _error = ex.Message;
        }
        catch (IOException)
        {
            _error = "No se pudo leer el archivo. ¿Seguro que es una banda y no pesa una barbaridad?";
        }
        finally
        {
            _busy = false;
        }
    }

    private Task Close() => OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }
}
