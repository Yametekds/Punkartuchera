@inject Rulebook Book

@* Armas, blindajes y equipo en tablas de papel, con ancla por objeto. *@
@if (Melee.Count > 0)
{
    <section class="paper rules-sheet">
        <h2 class="section-title" id="@($"{AnchorPrefix}cuerpo-a-cuerpo")">Armas cuerpo a cuerpo</h2>
        <div class="rules-table-wrap">
            <table class="data-table rules-gear">
                <thead>
                    <tr><th scope="col">Arma</th><th scope="col">Ptos</th><th scope="col">C</th><th scope="col">F</th><th scope="col">Pen</th><th scope="col">Reglas</th></tr>
                </thead>
                <tbody>
                    @foreach (var weapon in Melee)
                    {
                        <tr id="@weapon.Slug" class="rules-anchor">
                            <th scope="row">@weapon.Name @FactionStamp(weapon.FactionId)</th>
                            <td data-label="Ptos">@Cost(weapon.Cost)</td>
                            <td data-label="C">@weapon.Combat</td>
                            <td data-label="F">@weapon.Strength</td>
                            <td data-label="Pen">@weapon.Penetration</td>
                            <td data-label="Reglas"><SpecialRuleTags Names="weapon.Rules" />@Notes(weapon.Notes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Ranged.Count > 0)
{
    <section class="paper rules-sheet">
        <h2 class="section-title" id="@($"{AnchorPrefix}a-distancia")">Armas a distancia</h2>
        <div class="rules-table-wrap">
            <table class="data-table rules-gear">
                <thead>
                    <tr><th scope="col">Arma</th><th scope="col">Ptos</th><th scope="col">Alcance</th><th scope="col">F</th><th scope="col">Pen</th><th scope="col">Reglas</th></tr>
                </thead>
                <tbody>
                    @foreach (var weapon in Ranged)
                    {
                        <tr id="@weapon.Slug" class="rules-anchor">
                            <th scope="row">@weapon.Name @FactionStamp(weapon.FactionId)</th>
                            <td data-label="Ptos">@Cost(weapon.Cost)</td>
                            <td data-label="Alcance">@weapon.Range</td>
                            <td data-label="F">@weapon.Strength</td>
                            <td data-label="Pen">@weapon.Penetration</td>
                            <td data-label="Reglas"><SpecialRuleTags Names="weapon.Rules" />@Notes(weapon.Notes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Armors.Count > 0)
{
    <section class="paper rules-sheet">
        <h2 class="section-title" id="@($"{AnchorPrefix}blindajes")">Blindajes</h2>
        <div class="rules-table-wrap">
            <table class="data-table rules-gear">
                <thead>
                    <tr><th scope="col">Blindaje</th><th scope="col">Ptos</th><th scope="col">Valor</th><th scope="col">Reglas</th></tr>
                </thead>
                <tbody>
                    @foreach (var armor in Armors)
                    {
                        <tr id="@armor.Slug" class="rules-anchor">
                            <th scope="row">@armor.Name @FactionStamp(armor.FactionId)</th>
                            <td data-label="Ptos">@Cost(armor.Cost)</td>
                            <td data-label="Valor">@armor.Armor</td>
                            <td data-label="Reglas"><SpecialRuleTags Names="armor.Rules" />@Notes(armor.Notes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Gear.Count > 0)
{
    <section class="paper rules-sheet">
        <h2 class="section-title" id="@($"{AnchorPrefix}equipo")">Equipo</h2>
        <div class="rule-grid">
            @foreach (var item in Gear)
            {
                <article class="rule-box rules-anchor" id="@item.Slug">
                    <h3 class="rule-box__title">@item.Name@(item.Cost is null ? "" : $" · {item.Cost} ptos") @FactionStamp(item.FactionId)</h3>
                    <p class="rules-text">@item.Text</p>
                    <SourceRef Source="@item.Source" Page="item.Page" />
                </article>
            }
        </div>
    </section>
}

@code {
    [Parameter] public IReadOnlyList<Weapon> Weapons { get; set; } = [];

    [Parameter] public IReadOnlyList<ArmorItem> ArmorItems { get; set; } = [];

    [Parameter] public IReadOnlyList<GearItem> GearItems { get; set; } = [];

    /// <summary>Marca con un sello lo que es exclusivo de una facción.</summary>
    [Parameter] public bool ShowFaction { get; set; }

    [Parameter] public string AnchorPrefix { get; set; } = string.Empty;

    private List<Weapon> Melee => Weapons.Where(w => w.Kind == WeaponKind.Melee).ToList();

    private List<Weapon> Ranged => Weapons.Where(w => w.Kind == WeaponKind.Ranged).ToList();

    private List<ArmorItem> Armors => ArmorItems.ToList();

    private List<GearItem> Gear => GearItems.ToList();

    private static string Cost(int? cost) => cost is null ? "—" : cost.Value.ToString();

    private RenderFragment? FactionStamp(string? factionId) => !ShowFaction || factionId is null ? null :
        @<a class="rules-owner" href="@($"reglas/faccion/{factionId}")">@(Book.FindFaction(factionId)?.Name)</a>;

    private static RenderFragment? Notes(string? notes) => string.IsNullOrWhiteSpace(notes) ? null :
        @<span class="rules-note">@notes</span>;
}
