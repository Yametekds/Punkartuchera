@using Punkartuchera.Core.Tournaments
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Hoja del organizador para escanear el QR de resultado que enseña el móvil de una mesa. *@
<div class="sheet-scrim" @onclick="Close"></div>
<section class="sheet paper" role="dialog" aria-modal="true" aria-labelledby="scan-title">
    <header class="sheet__head">
        <h2 id="scan-title" class="sheet__title">Escanear resultado</h2>
        <button type="button" class="btn btn--icon sheet__close" aria-label="Cerrar" @onclick="Close"><Icon Path="@Icons.Close" /></button>
    </header>

    <p>En el móvil de la mesa: <strong>Partida › QR del resultado para el torneo</strong>. Apunta aquí.</p>
    <div class="scanner @(_cameraState == "ok" ? "is-live" : null)">
        <video @ref="_video" class="scanner__video" playsinline muted></video>
        @if (_cameraState == "ok")
        {
            <span class="scanner__frame" aria-hidden="true"></span>
        }
        else
        {
            <p class="scanner__msg">@CameraMessage</p>
        }
    </div>

    @if (_error is not null)
    {
        <p class="notice notice--danger" role="alert">@_error</p>
    }

    <p class="sheet__small">¿No hay manera? Cierra esto y dale a <strong>Apuntar a mano</strong> en la mesa.</p>
</section>

@code {
    [Parameter, EditorRequired] public Tournament Tournament { get; set; } = default!;

    [Parameter] public EventCallback<ScannedResult> OnScanned { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _video;
    private IJSObjectReference? _module;
    private DotNetObjectReference<TournamentScanSheet>? _self;
    private string _cameraState = "starting";
    private string? _error;
    private bool _done;

    private string CameraMessage => _cameraState switch
    {
        "denied" => "Sin permiso para la cámara. Dáselo en el navegador o apúntalo a mano.",
        "nocamera" => "Aquí no hay cámara a la vista. Apúntalo a mano.",
        "error" => "La cámara no arranca. Apúntalo a mano.",
        _ => "Encendiendo la cámara…",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Punkartuchera.UI/js/punkQr.js");
            _self = DotNetObjectReference.Create(this);
            _cameraState = await _module.InvokeAsync<string>("start", _video, _self);
        }
        catch (JSException)
        {
            _cameraState = "error";
        }

        StateHasChanged();
    }

    /// <summary>Lo llama el lector con cada QR que ve; devuelve si hay que seguir escaneando.</summary>
    [JSInvokable]
    public async Task<bool> OnCode(string text)
    {
        if (_done)
        {
            return false;
        }

        if (BandQrCodec.LooksLikeBand(text))
        {
            _error = "Eso es una banda, no un resultado. Las bandas se cargan desde Bandas.";
            StateHasChanged();
            return true;
        }

        try
        {
            var scanned = TournamentService.Locate(Tournament, text);
            _done = true;
            await OnScanned.InvokeAsync(scanned);
            return false;
        }
        catch (TournamentException ex)
        {
            _error = ex.Message;
            StateHasChanged();
            return true;
        }
    }

    private Task Close() => OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }
}
