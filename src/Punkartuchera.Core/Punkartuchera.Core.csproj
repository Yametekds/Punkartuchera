<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Rules\Data\core.json" LogicalName="Punkartuchera.Rules.core.json" />
    <EmbeddedResource Include="Rules\Data\factions\*.json" LogicalName="Punkartuchera.Rules.factions.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Rules\Data\subfactions\*.json" LogicalName="Punkartuchera.Rules.subfactions.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Rules\Data\lists.json" LogicalName="Punkartuchera.Rules.lists.json" />
    <EmbeddedResource Include="Rules\Data\minis.json" LogicalName="Punkartuchera.Rules.minis.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Punkartuchera.Relay.Contracts\Punkartuchera.Relay.Contracts.csproj" />
  </ItemGroup>

</Project>
